<div class="th-page">
  <div class="th-header">
    <div class="th-header-top">
      <a href="/task12" class="th-back">← Задание №12</a>
      <h2 class="th-title">Личные окончания и суффиксы причастий — теория</h2>
    </div>
    <p class="th-desc">
      В этом задании проверяется правописание окончаний глаголов и суффиксов причастий/деепричастий.
      Главный принцип: определить время, найти инфинитив и выбрать букву по спряжению или по суффиксу перед <b>-ть</b>.
    </p>
  </div>

  <div class="th-blocks">
    <div class="th-block" data-practice="form:past">
      <div class="th-block-head">
        <span class="th-section-num">1</span>
        <h3 class="th-section-title">Схема 1: спряжение не определяем</h3>
      </div>
      <div class="th-block-body">
        <p class="t12th-rule-line">В этих случаях берём букву из начальной формы и переносим в слово.</p>
        <div class="t12th-scheme-grid t12th-scheme-grid--3">
          <div class="t12th-scheme-card t12th-scheme-card--green">
            <div class="t12th-scheme-title">Суффиксы <b>-вш-, -л-, -в-</b></div>
            <div class="t12th-scheme-text">Берём букву перед <b>-ть</b> в инфинитиве: <i>сеять → сеявший</i>, <i>успокоить → успокоил</i>.</div>
          </div>
          <div class="t12th-scheme-card t12th-scheme-card--green">
            <div class="t12th-scheme-title">Причастия на <b>-нн-</b></div>
            <div class="t12th-scheme-text">-ать/-ять → <b>-анн-/-янн-</b>, иначе чаще <b>-енн-</b>: <i>всклокочить → всклокоченный</i>.</div>
          </div>
          <div class="t12th-scheme-card t12th-scheme-card--green">
            <div class="t12th-scheme-title">Ключевое действие</div>
            <div class="t12th-scheme-text">Спряжение здесь не считаем: работаем только с инфинитивом.</div>
          </div>
        </div>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>

    <div class="th-block" data-practice="spr">
      <div class="th-block-head">
        <span class="th-section-num">2</span>
        <h3 class="th-section-title">Схема 2: как определить спряжение</h3>
      </div>
      <div class="th-block-body">
        <p class="t12th-rule-line">Сначала определяем спряжение, а потом уже выбираем букву в окончании/суффиксе.</p>
        <div class="t12th-scheme-grid t12th-scheme-grid--2">
          <div class="t12th-scheme-card t12th-scheme-card--yellow">
            <div class="t12th-scheme-title">Базовое правило</div>
            <div class="t12th-scheme-text"><b>-ить = II спряжение</b>, остальные глаголы обычно <b>I спряжения</b>.</div>
          </div>
          <div class="t12th-scheme-card t12th-scheme-card--yellow">
            <div class="t12th-scheme-title">Исключения</div>
            <div class="t12th-scheme-text">I: <i>брить, стелить, зиждиться, зыбиться</i>.<br>II: <i>слышать, гнать, дышать, держать, видеть, обидеть, зависеть, терпеть, вертеть, ненавидеть, смотреть</i>.</div>
          </div>
        </div>
        <div class="th-tip">Алгоритм: найти инфинитив → определить спряжение → перейти к выбору букв по схеме 3 и 4.</div>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>

    <div class="th-block" data-practice="form:present_future">
      <div class="th-block-head">
        <span class="th-section-num">3</span>
        <h3 class="th-section-title">Схема 3: У/Ю (I спр.) и А/Я (II спр.)</h3>
      </div>
      <div class="th-block-body">
        <p class="t12th-rule-line">Этот шаг для строк с формами типа <b>...щ...</b> и <b>они ...т</b>.</p>
        <div class="t12th-scheme-grid t12th-scheme-grid--2">
          <div class="t12th-scheme-card t12th-scheme-card--orange">
            <div class="t12th-scheme-title">Выбор букв</div>
            <div class="t12th-scheme-text"><b>I спряжение → У/Ю</b><br><b>II спряжение → А/Я</b></div>
          </div>
          <div class="t12th-scheme-card t12th-scheme-card--orange">
            <div class="t12th-scheme-title">Пример</div>
            <div class="t12th-scheme-text"><i>кле..т</i> → <i>клеить</i> (II) → выбираем из А/Я → <b>клеят</b>.</div>
          </div>
        </div>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>

    <div class="th-block" data-practice="spr">
      <div class="th-block-head">
        <span class="th-section-num">4</span>
        <h3 class="th-section-title">Схема 4: Е (I спр.) и И (II спр.)</h3>
      </div>
      <div class="th-block-body">
        <p class="t12th-rule-line">В остальных личных окончаниях вставляем только <b>Е</b> или <b>И</b>.</p>
        <div class="t12th-scheme-grid t12th-scheme-grid--2">
          <div class="t12th-scheme-card t12th-scheme-card--yellow">
            <div class="t12th-scheme-title">Формула окончания</div>
            <div class="t12th-scheme-text"><b>I спряжение → Е</b><br><b>II спряжение → И</b></div>
          </div>
          <div class="t12th-scheme-card t12th-scheme-card--yellow">
            <div class="t12th-scheme-title">Пример</div>
            <div class="t12th-scheme-text"><i>он пове..т</i> → <i>веять</i> (I) → вставляем <b>Е</b> → <b>повеет</b>.</div>
          </div>
        </div>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>

    <div class="th-block" data-practice="examples">
      <div class="th-block-head">
        <span class="th-section-num">5</span>
        <h3 class="th-section-title">Разборы из задания (как в ЕГЭ)</h3>
      </div>
      <div class="th-block-body">
        <div class="t12th-example"><b>Они кле..т</b> → кле<b>и</b>ть → II спряжение → выбираем И/А/Я → <b>клеят</b>.</div>
        <div class="t12th-example"><b>Он пове..т</b> → ве<b>я</b>ть → I спряжение → выбираем Е/У/Ю → <b>повеет</b>.</div>
        <div class="t12th-example"><b>Тащ..щаяся</b> → тащ<b>и</b>ться → II спряжение → <b>тащащаяся</b>.</div>
        <div class="t12th-example"><b>Он успоко..л</b> → успоко<b>и</b>ть → прошедшее время, берём букву перед -ть → <b>успокоил</b>.</div>
        <div class="t12th-example"><b>Се..вший</b> → се<b>я</b>ть → прошедшее причастие, берём букву перед -ть → <b>сеявший</b>.</div>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>

    <div class="th-block" data-practice="special">
      <div class="th-block-head">
        <span class="th-section-num">6</span>
        <h3 class="th-section-title">Особые случаи и что запомнить</h3>
      </div>
      <div class="th-block-body">
        <ul class="th-list">
          <li><b>Глаголы с приставкой вы-:</b> отбрось приставку; если гласная становится ударной — пиши то, что слышишь.</li>
          <li><b>Если после удаления вы-</b> ударения нет — снова определяй спряжение по инфинитиву.</li>
          <li><b>Запомнить:</b> движимый, недвижимый, немыслимый, приемлемый, неотъемлемый.</li>
          <li><b>Повторить отдельно:</b> спряжение глаголов <i>хотеть, бежать, есть, дать</i>.</li>
          <li><b>Приставочные производные</b> наследуют окончания исходного глагола: <i>гнать → перегнать, дать → передать</i>.</li>
        </ul>
        <button type="button" class="th-practice-btn">Тренировать этот блок</button>
      </div>
    </div>
  </div>

  <div class="th-train-footer">
    <div>
      <div class="th-train-footer__title">Готова к практике по 12 заданию?</div>
      <div class="th-train-footer__desc">Сгенерируем тренировочное задание по алгоритму теории.</div>
    </div>
    <button id="t12th-train-all-btn" class="btn btn-primary">Тренироваться</button>
  </div>
</div>

<style>
/* Схемы с цветными акцентами — уникальны для задания 12 */
.t12th-rule-line { margin: 0 0 12px; color: var(--text-secondary); font-size: 14px; line-height: 1.55; }

.t12th-scheme-grid { display: grid; gap: 10px; margin-bottom: 14px; }
.t12th-scheme-grid--2 { grid-template-columns: 1fr 1fr; }
.t12th-scheme-grid--3 { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 760px) {
  .t12th-scheme-grid--2,
  .t12th-scheme-grid--3 { grid-template-columns: 1fr; }
}

.t12th-scheme-card {
  border-radius: 12px;
  border: 1px solid var(--glass-border);
  background: var(--bg-primary);
  padding: 12px 14px;
}
.t12th-scheme-card--green  { border-left: 1px solid #6ecf8f; }
.t12th-scheme-card--orange { border-left: 1px solid #e2a07a; }
.t12th-scheme-card--yellow { border-left: 1px solid #d4ba62; }
.t12th-scheme-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
.t12th-scheme-text  { font-size: 13px; line-height: 1.5; color: var(--text-secondary); }

.t12th-example {
  padding: 10px 12px;
  border: 1px solid var(--glass-border);
  border-radius: 10px;
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 8px;
}
.t12th-example:last-of-type { margin-bottom: 14px; }
</style>

<script>
(function initTask12Theory() {
  const icon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>';

  function getPayloadByPracticeKey(key) {
    if (key === 'form:present_future') return { form_types: ['verb', 'active_part'], tasks_count: 1, correct_counts: ['2'], is_practice: true };
    if (key === 'form:past')           return { form_types: ['passive_part', 'active_part'], vowel_pairs: ['е/и'], tasks_count: 1, correct_counts: ['2'], is_practice: true };
    if (key === 'spr')                 return { form_types: ['verb', 'active_part', 'passive_part'], tasks_count: 1, correct_counts: ['2'], is_practice: true };
    if (key === 'examples')            return { tasks_count: 1, correct_counts: ['2'], is_practice: true };
    if (key === 'special')             return { vowel_pairs: ['е/и', 'ю/я', 'у/а'], tasks_count: 1, correct_counts: ['2'], is_practice: true };
    return { tasks_count: 1, correct_counts: ['2'], is_practice: true };
  }

  async function startPractice(payload, btn) {
    btn.disabled = true;
    btn.textContent = 'Создаём задание...';
    try {
      const res = await fetch('/api/task12/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json();
      if (data.id) { window.location.href = '/task12/' + data.id; return; }
      btn.textContent = 'Нет доступных заданий';
    } catch {
      btn.textContent = 'Ошибка загрузки';
    } finally {
      setTimeout(() => { btn.disabled = false; btn.innerHTML = icon + ' Тренировать этот блок'; }, 1400);
    }
  }

  document.querySelectorAll('.th-block[data-practice]').forEach((block) => {
    const btn = block.querySelector('.th-practice-btn');
    if (!btn) return;
    btn.innerHTML = icon + ' Тренировать этот блок';
    btn.addEventListener('click', () => startPractice(getPayloadByPracticeKey(block.dataset.practice || ''), btn));
  });

  const trainAllBtn = document.getElementById('t12th-train-all-btn');
  if (trainAllBtn) {
    trainAllBtn.addEventListener('click', async () => {
      trainAllBtn.disabled = true;
      trainAllBtn.textContent = 'Создаём задание...';
      try {
        const res = await fetch('/api/task12/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tasks_count: 1, correct_counts: ['2'], is_practice: true }) });
        const data = await res.json();
        if (data.id) { window.location.href = '/task12/' + data.id; return; }
        trainAllBtn.textContent = 'Нет доступных заданий';
      } catch {
        trainAllBtn.textContent = 'Ошибка загрузки';
      } finally {
        setTimeout(() => { trainAllBtn.disabled = false; trainAllBtn.textContent = 'Тренироваться'; }, 1400);
      }
    });
  }
})();

fetch('/api/progress/theory/view', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ task_key: 'task12' })
}).catch(() => {});
</script>
