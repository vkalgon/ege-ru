      {s:"КЕГЛИ",p:"КЕГЛЕЙ",w:"КЕГЛЕВ"},{s:"КОЗНИ",p:"КОЗНЕЙ",w:"КОЗНЕВ"},
      {s:"ЛАДОНИ",p:"ЛАДОНЕЙ",w:"ЛАДОНЕВ"},{s:"ПРОСТЫНИ",p:"ПРОСТЫНЕЙ",w:"ПРОСТЫНЕВ"},
      {s:"РАСПРИ",p:"РАСПРЕЙ",w:"РАСПРЕВ"},{s:"СКАТЕРТИ",p:"СКАТЕРТЕЙ",w:"СКАТЕРТЕВ"},
      {s:"ТЁТИ",p:"ТЁТЕЙ",w:"ТЁТЕВ"},{s:"ЧУКЧИ",p:"ЧУКЧЕЙ",w:"ЧУКЧЕВ"},
      {s:"ЯСЛИ",p:"ЯСЛЕЙ",w:"ЯСЛЕВ"},{s:"БАРЖИ",p:"БАРЖ",w:"БАРЖЕЙ"},
      {s:"БАСНЯ",p:"БАСЕН",w:"БАСНЕЙ"},{s:"БАШНЯ",p:"БАШЕН",w:"БАШНЕЙ"},
      {s:"БРЫЗГИ",p:"БРЫЗГ",w:"БРЫЗГОВ"},{s:"ВАФЛЯ",p:"ВАФЕЛЬ",w:"ВАФЛЕЙ"},
      {s:"ДЕЛО",p:"ДЕЛ",w:"ДЕЛОВ"},{s:"КОПНА",p:"КОПЁН",w:"КОПНОВ"},
      {s:"КОЧЕРГА",p:"КОЧЕРЁГ",w:"КОЧЕРГОВ"},{s:"КУХНЯ",p:"КУХОНЬ",w:"КУХНЕЙ"},
      {s:"МАКАРОНЫ",p:"МАКАРОН",w:"МАКАРОНОВ"},{s:"МАНЖЕТА",p:"МАНЖЕТ",w:"МАНЖЕТОВ"},
      {s:"НЯНЯ",p:"НЯНЬ",w:"НЯНЕЙ"},{s:"ПЕТЛЯ",p:"ПЕТЕЛЬ",w:"ПЕТЛЕЙ"},
      {s:"САБЛЯ",p:"САБЕЛЬ",w:"САБЛЕЙ"},{s:"СЕРЬГА",p:"СЕРЁГ",w:"СЕРЁГОВ"},
      {s:"СПЛЕТНЯ",p:"СПЛЕТЕН",w:"СПЛЕТНЕЙ"},{s:"ТУФЛИ",p:"ТУФЕЛЬ",w:"ТУФЛЕЙ"},
      {s:"ЦАПЛЯ",p:"ЦАПЕЛЬ",w:"ЦАПЛЕЙ"},{s:"ШПРОТЫ",p:"ШПРОТ",w:"ШПРОТОВ"},
      {s:"ЯБЛОНЯ",p:"ЯБЛОНЬ",w:"ЯБЛОНЕЙ"},{s:"БРОНХИ",p:"БРОНХОВ",w:"БРОНХ"},
      {s:"ГЕОРГИНЫ",p:"ГЕОРГИНОВ",w:"ГЕОРГИН"},{s:"ДЕБАТЫ",p:"ДЕБАТОВ",w:"ДЕБАТ"},
      {s:"ЗАМОРОЗКИ",p:"ЗАМОРОЗКОВ",w:"ЗАМОРОЗОК"},{s:"КОНСЕРВЫ",p:"КОНСЕРВОВ",w:"КОНСЕРВ"},
      {s:"НЕРВЫ",p:"НЕРВОВ",w:"НЕРВ"}
    ]
  }
];

/* ── Журнал ── */
function t7qLsKey(id){ return "t7quiz_j_"+id; }
function t7qLoadJ(id){ try{ var r=localStorage.getItem(t7qLsKey(id)); return r?JSON.parse(r):[]; }catch(e){ return []; } }
function t7qSaveJ(id,list){ try{ localStorage.setItem(t7qLsKey(id),JSON.stringify(list)); }catch(e){} }
function t7qJAdd(id,item){ var l=t7qLoadJ(id); if(!l.some(function(e){return e.s===item.s;})){ l.push(item); t7qSaveJ(id,l); } }
function t7qJRemove(id,s){ t7qSaveJ(id,t7qLoadJ(id).filter(function(e){return e.s!==s;})); }
function t7qJClear(id){ try{ localStorage.removeItem(t7qLsKey(id)); }catch(e){} }

/* ── Состояние ── */
var t7qS = { topic:null, words:[], idx:0, errs:[], locked:false };

/* ── Утилиты ── */
function t7qShuffle(arr){
  var a=arr.slice();
  for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i];a[i]=a[j];a[j]=t; }
  return a;
}
function t7qWrongForm(p){
  var last=p.slice(-1);
  if(last==="А") return p.slice(0,-1)+"Ы";
  if(last==="Я") return p.slice(0,-1)+"И";
  if(last==="Ы") return p.slice(0,-1)+"А";
  if(last==="И") return p.slice(0,-1)+"Я";
  return p+"?";
}
function t7qPlural(n,one,two,five){ var m=Math.abs(n)%100,m10=m%10; if(m>10&&m<20)return five; if(m10===1)return one; if(m10>=2&&m10<=4)return two; return five; }

function t7qShow(id){ document.getElementById("t7q-home").classList.remove("t7q-active"); document.getElementById("t7q-quiz").classList.remove("t7q-active"); document.getElementById("t7q-results").classList.remove("t7q-active"); document.getElementById(id).classList.add("t7q-active"); }

/* ── Главная ── */
function t7qBuildHome(){
  var html="";
  T7Q_TOPICS.forEach(function(t){
    var saved=t7qLoadJ(t.id);
    var jHtml="";
    if(saved.length>0){
      jHtml='<div class="t7q-journal-hint"><span class="t7q-journal-count">📌 '+saved.length+' '+t7qPlural(saved.length,"ошибка","ошибки","ошибок")+' в журнале</span><button class="t7q-journal-go" data-journal="'+t.id+'">Работать →</button></div>';
    }
    html+='<div class="t7q-topic-card" data-id="'+t.id+'"><div class="t7q-topic-num">Тема '+t.num+'</div><div class="t7q-topic-title">'+t.title+'</div><div class="t7q-topic-meta">'+t.sub+' · '+t.words.length+' слов</div>'+jHtml+'</div>';
  });
  document.getElementById("t7q-topics-grid").innerHTML=html;

  document.querySelectorAll(".t7q-topic-card").forEach(function(card){
    card.addEventListener("click",function(e){
      var btn=e.target.closest("[data-journal]");
      if(btn){ e.stopPropagation(); var id=btn.getAttribute("data-journal"); var saved=t7qLoadJ(id); if(saved.length) t7qStartTopic(id,saved); return; }
      t7qStartTopic(card.getAttribute("data-id"));
    });
  });
}

/* ── Тест ── */
function t7qStartTopic(id,wordsOverride){
  var t=T7Q_TOPICS.find(function(x){return x.id===id;});
  t7qS.topic=t; t7qS.words=t7qShuffle(wordsOverride||t.words); t7qS.idx=0; t7qS.errs=[]; t7qS.locked=false;
  document.getElementById("t7q-label").textContent=t.label;
  t7qShow("t7q-quiz");
  t7qRenderQ();
}

function t7qRenderQ(){
  var total=t7qS.words.length, item=t7qS.words[t7qS.idx];
  var right=item.p, wrong=item.w||t7qWrongForm(right);
  var opts=t7qShuffle([right,wrong]);
  document.getElementById("t7q-counter").textContent=(t7qS.idx+1)+" / "+total;
  document.getElementById("t7q-prog-fill").style.width=(t7qS.idx/total*100)+"%";
  document.getElementById("t7q-word").textContent=item.s;
  var fb=document.getElementById("t7q-feedback"); fb.textContent=""; fb.className="t7q-feedback";
  var el=document.getElementById("t7q-options"); el.innerHTML="";
  opts.forEach(function(val){
    var btn=document.createElement("button"); btn.className="t7q-opt"; btn.textContent=val; btn.setAttribute("data-val",val); el.appendChild(btn);
  });
  el.querySelectorAll(".t7q-opt").forEach(function(b){
    b.addEventListener("click",function(){ t7qAnswer(b,b.getAttribute("data-val"),right,wrong,item); });
  });
  t7qS.locked=false;
}

function t7qAnswer(btn,chosen,right,wrong,item){
  if(t7qS.locked) return; t7qS.locked=true;
  var ok=(chosen===right);
  document.querySelectorAll(".t7q-opt").forEach(function(b){
    b.disabled=true;
    var v=b.getAttribute("data-val");
    if(v===right) b.classList.add(ok?"correct":"reveal");
    if(v===wrong&&!ok) b.classList.add("wrong");
  });
  var fb=document.getElementById("t7q-feedback");
  if(ok){ fb.textContent="✓ Верно!"; fb.className="t7q-feedback ok"; t7qJRemove(t7qS.topic.id,item.s); }
  else  { fb.textContent="✗ Правильно: "+right; fb.className="t7q-feedback bad"; t7qS.errs.push(item); t7qJAdd(t7qS.topic.id,item); }
  setTimeout(function(){ t7qS.idx++; if(t7qS.idx>=t7qS.words.length) t7qShowResults(); else t7qRenderQ(); },1400);
}

/* ── Результаты ── */
function t7qShowResults(){
  var total=t7qS.words.length, ok=total-t7qS.errs.length, pct=Math.round(ok/total*100);
  var ring=document.getElementById("t7q-ring");
  ring.className="t7q-score-ring "+(pct>=80?"great":pct>=50?"good":"poor");
  document.getElementById("t7q-s-num").textContent=ok;
  document.getElementById("t7q-s-tot").textContent=total;
  var levels=[[100,"Отлично! Ни одной ошибки!","Блестящий результат — все слова знаете."],[80,"Очень хорошо!","Почти всё правильно — осталось закрепить."],[50,"Неплохо!","Есть что повторить — не останавливайтесь."],[0,"Нужно потренироваться.","Повторите ошибки и попробуйте снова."]];
  var level=levels[levels.length-1];
  for(var i=0;i<levels.length;i++){ if(pct>=levels[i][0]){level=levels[i];break;} }
  document.getElementById("t7q-r-title").textContent=level[1];
  document.getElementById("t7q-r-sub").textContent=level[2];
  var errBox=document.getElementById("t7q-err-box"), retBtn=document.getElementById("t7q-retry-err-btn");
  if(t7qS.errs.length>0){
    errBox.style.display="block"; retBtn.style.display="inline-block";
    document.getElementById("t7q-err-list").innerHTML=t7qS.errs.map(function(e){ return '<div class="t7q-err-row"><span class="sg">'+e.s+'</span><span class="arrow">→</span><span class="pl">'+e.p+'</span></div>'; }).join("");
  } else { errBox.style.display="none"; retBtn.style.display="none"; }
  var saved=t7qLoadJ(t7qS.topic.id), jBar=document.getElementById("t7q-journal-bar");
  if(saved.length>0){ jBar.style.display="block"; document.getElementById("t7q-j-count").textContent=saved.length; }
  else { jBar.style.display="none"; }
  t7qShow("t7q-results");
}

/* ── Кнопки ── */
document.getElementById("t7q-back-btn").addEventListener("click",function(){ t7qBuildHome(); t7qShow("t7q-home"); });
document.getElementById("t7q-home-btn").addEventListener("click",function(){ t7qBuildHome(); t7qShow("t7q-home"); });
document.getElementById("t7q-retry-all-btn").addEventListener("click",function(){ t7qStartTopic(t7qS.topic.id); });
document.getElementById("t7q-retry-err-btn").addEventListener("click",function(){ if(t7qS.errs.length) t7qStartTopic(t7qS.topic.id,t7qS.errs); });
document.getElementById("t7q-j-retry").addEventListener("click",function(){ var s=t7qLoadJ(t7qS.topic.id); if(s.length) t7qStartTopic(t7qS.topic.id,s); });
document.getElementById("t7q-j-clear").addEventListener("click",function(){ if(confirm("Очистить весь журнал ошибок по этой теме?")){ t7qJClear(t7qS.topic.id); document.getElementById("t7q-journal-bar").style.display="none"; } });

t7qBuildHome();
})();
</script>
