<!-- ══════════════════ СТИЛИ ══════════════════ -->
<style>
/* ── Словари ── */
.t7-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.t7-three-col {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
}
@media (max-width: 640px) {
  .t7-two-col, .t7-three-col { grid-template-columns: 1fr; }
}
.t7-group-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 8px;
}
.t7-group-label--accent { color: var(--brand); }
.t7-word-grid {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.t7-wp {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid var(--glass-border);
  background: var(--bg-primary);
  line-height: 1.4;
}
.t7-wp b { color: var(--text-primary); }
.t7-wp--accent { border-color: rgba(164,190,226,.3); background: rgba(164,190,226,.05); }
.t7-wp--accent b { color: var(--brand); }

/* ── Обёртка тренажёра ── */
.t7q-section {
  margin-top: 32px;
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  background: var(--bg-secondary);
  overflow: hidden;
}
.t7q-section-head {
  padding: 20px 24px 14px;
  border-bottom: 1px solid var(--glass-border);
}
.t7q-section-title {
  margin: 0 0 4px;
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
}
.t7q-section-desc {
  margin: 0;
  font-size: 13px;
  color: var(--text-secondary);
}

/* ── Экраны ── */
.t7q-screen { display: none; }
.t7q-active { display: block; }

/* ── Список тем ── */
.t7q-topics {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px;
  padding: 16px;
}
.t7q-topic-card {
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  background: var(--bg-primary);
  padding: 16px 18px;
  cursor: pointer;
  transition: border-color .15s, transform .15s;
  user-select: none;
}
.t7q-topic-card:hover { border-color: var(--brand); transform: translateY(-1px); }
.t7q-topic-num   { font-size: 10px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 5px; }
.t7q-topic-title { font-size: 13px; font-weight: 700; color: var(--text-primary); margin-bottom: 3px; }
.t7q-topic-meta  { font-size: 12px; color: var(--text-secondary); }
.t7q-journal-hint { margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(224,92,101,.3); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.t7q-journal-count { font-size: 11px; font-weight: 600; color: var(--color-error); }
.t7q-journal-go { background: rgba(224,92,101,.1); color: var(--color-error); border: none; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 700; cursor: pointer; flex-shrink: 0; }
.t7q-journal-go:hover { background: rgba(224,92,101,.2); }

/* ── Квиз ── */
.t7q-quiz-wrap { max-width: 520px; margin: 0 auto; padding: 20px 16px; }
.t7q-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.t7q-back { background: none; border: none; font-size: 13px; color: var(--text-secondary); cursor: pointer; padding: 0; }
.t7q-back:hover { color: var(--text-primary); }
.t7q-counter { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
.t7q-prog-bar { height: 5px; background: var(--glass-border); border-radius: 3px; overflow: hidden; margin-bottom: 24px; }
.t7q-prog-fill { height: 100%; background: var(--brand); border-radius: 3px; transition: width .35s ease; }
.t7q-card { background: var(--bg-primary); border: 1px solid var(--glass-border); border-radius: 14px; padding: 32px 24px 28px; text-align: center; margin-bottom: 14px; }
.t7q-label { font-size: 12px; color: var(--text-secondary); margin-bottom: 12px; }
.t7q-word  { font-size: 2rem; font-weight: 800; letter-spacing: .04em; color: var(--text-primary); }
.t7q-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.t7q-opt {
  background: var(--bg-primary);
  border: 2px solid var(--glass-border);
  border-radius: 12px;
  padding: 18px 10px;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
  color: var(--text-primary);
  transition: border-color .12s, background .12s;
}
.t7q-opt:hover:not(:disabled) { border-color: var(--brand); background: var(--brand-muted); }
.t7q-opt:disabled { cursor: default; }
.t7q-opt.correct { border-color: var(--color-success); background: rgba(164,226,208,.1); color: var(--color-success); }
.t7q-opt.wrong   { border-color: var(--color-error);   background: rgba(224,92,101,.1); color: var(--color-error); }
.t7q-opt.reveal  { border-color: var(--color-success); background: rgba(164,226,208,.1); color: var(--color-success); }
.t7q-feedback { text-align: center; min-height: 24px; margin-top: 12px; font-size: 14px; font-weight: 600; color: var(--text-secondary); }
.t7q-feedback.ok  { color: var(--color-success); }
.t7q-feedback.bad { color: var(--color-error); }

/* ── Результаты ── */
.t7q-res-card { max-width: 480px; margin: 0 auto; padding: 32px 24px; text-align: center; }
.t7q-score-ring { width: 100px; height: 100px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 18px; }
.t7q-score-ring.great { background: rgba(164,226,208,.1); color: var(--color-success); border: 2px solid rgba(164,226,208,.3); }
.t7q-score-ring.good  { background: rgba(255,176,32,.08); color: var(--color-warning); border: 2px solid rgba(255,176,32,.3); }
.t7q-score-ring.poor  { background: rgba(224,92,101,.1); color: var(--color-error);   border: 2px solid rgba(224,92,101,.3); }
.t7q-ring-big { font-size: 2rem; font-weight: 800; line-height: 1; }
.t7q-ring-sm  { font-size: 11px; opacity: .7; margin-top: 2px; }
.t7q-res-title { font-size: 18px; font-weight: 800; color: var(--text-primary); margin-bottom: 5px; }
.t7q-res-sub   { font-size: 13px; color: var(--text-secondary); margin-bottom: 22px; }
.t7q-err-box { text-align: left; margin-bottom: 20px; max-height: 200px; overflow-y: auto; }
.t7q-err-label { font-size: 11px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 8px; }
.t7q-err-row { display: flex; align-items: center; gap: 8px; background: rgba(224,92,101,.07); border: 1px solid rgba(224,92,101,.2); border-radius: 7px; padding: 7px 12px; margin-bottom: 5px; font-size: 13px; }
.t7q-err-row .sg    { font-weight: 700; color: var(--color-error); }
.t7q-err-row .arrow { color: var(--text-secondary); }
.t7q-err-row .pl    { font-weight: 700; color: var(--color-success); margin-left: auto; }
.t7q-journal-bar { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--glass-border); }
.t7q-j-info { font-size: 12px; color: var(--text-secondary); margin-bottom: 10px; }
.t7q-j-info strong { color: var(--text-primary); }
.t7q-j-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
.t7q-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
.t7q-btn { padding: 10px 20px; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; transition: all .15s; }
.t7q-btn-ghost   { background: var(--bg-tertiary); color: var(--text-primary); }
.t7q-btn-ghost:hover   { background: var(--glass-border); }
.t7q-btn-primary { background: var(--brand); color: var(--bg-primary); }
.t7q-btn-primary:hover { background: var(--brand-dark); }
.t7q-btn-warn    { background: rgba(224,92,101,.1); color: var(--color-error); border: 1px solid rgba(224,92,101,.3); }
.t7q-btn-warn:hover    { background: rgba(224,92,101,.18); }
.t7q-btn-sm { padding: 7px 14px; font-size: 12px; }
</style>

