/* ── Задание №11 ─────────────────────────────────────── */
const T11_RULES_MAP = {
  'глагол':            { 'variable': [['ова/ыва','-ова-/-ева- vs -ыва-/-ива-'],['перед_вш','гласная перед -вш-/-л-/-в-'],['обес/обез','обес-/обез-']] },
  'прилагательное':    { 'variable': [['ев/ив','-ев-/-ив-'],['к/ск','-к-/-ск-'],['ян/ен','-ян-/-ен-'],['ач/еч','-ач-/-еч-'],['ин/ен','-ин-/-ен-']],
                         'fixed':    [['лив/чив','-лив-/-чив-'],['еньк/оньк','-еньк-/-оньк-'],['еват/оват','-еват-/-оват-'],['ист','-ист-'],['чат','-чат-']] },
  'существительное':   { 'variable': [['ик/ек','-ик- vs -ек-'],['ец/иц','-ец- vs -иц-'],['чик/щик','-чик-/-щик-'],['инк/енк','-инк- / -енк-'],['ичк/ечк','-ичк- / -ечк-']],
                         'fixed':    [['изн/от/ин','-изн-/-от-/-ин-']] },
  'наречие':           { 'fixed':    [['о/а_нар','о/а в наречиях']] },
  'о/ё после шипящей': { 'fixed':    [['о/ё_ё_гл','ё — от глагола'],['о/ё_ё_ёр','ё — суффикс -ёр-'],['о/ё_о','о']] }
};

function t11ComputeRules(selectedPos, selectedCat) {
  const posKeys = selectedPos.length ? selectedPos : Object.keys(T11_RULES_MAP);
  const catKeys = selectedCat.length ? selectedCat : ['variable', 'fixed'];
  const seen = new Set();
  const result = [];
  for (const pos of posKeys) {
    for (const cat of catKeys) {
      for (const [value, label] of ((T11_RULES_MAP[pos] || {})[cat] || [])) {
        if (!seen.has(value)) { seen.add(value); result.push({ value, label }); }
      }
    }
  }
  return result;
}

const t11GenBar = new FilterBar(document.getElementById('gen-t11-filter-bar'));

const t11GenPosPill = t11GenBar.addPill('Часть речи', [
  { value: 'глагол',            label: 'глагол' },
