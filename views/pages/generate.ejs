<script src="/js/filter-bar.js"></script>
<script>
window.addEventListener('error', function(e) {
  console.error('Generate page error:', e.message, e.filename, e.lineno);
  var errDiv = document.getElementById('generate-page-error');
  if (!errDiv) {
    errDiv = document.createElement('div');
    errDiv.id = 'generate-page-error';
    errDiv.style.cssText = 'margin:12px 0;padding:12px;background:#fee;border:1px solid #e05c65;border-radius:8px;color:#c00;font-size:13px;';
    var title = document.querySelector('.task-page__title');
    if (title) title.insertAdjacentElement('afterend', errDiv);
    else document.body.prepend(errDiv);
  }
  errDiv.textContent = 'Ошибка инициализации: ' + e.message + ' (строка ' + e.lineno + ')';
});

/* ── Задание №4 ─────────────────────────────────────── */
document.getElementById('gen-btn-task4').addEventListener('click', async () => {
  const btn = document.getElementById('gen-btn-task4');
  btn.disabled = true; btn.textContent = 'Генерируем...';
  try {
    const res = await fetch('/api/task4/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tasks_count: +document.getElementById('gen-t4-count').value || 1, is_practice: true })
    });
    const data = await res.json();
    if (!res.ok || data.error) { alert(data.error || ('Ошибка: ' + res.status)); return; }
    location.href = '/task4/' + data.id;
  } catch (err) {
    alert('Ошибка: ' + err.message);
  } finally {
    btn.disabled = false; btn.textContent = 'Сгенерировать';
  }
});

/* ── Задание №9 ─────────────────────────────────────── */
const t9GenBar = new FilterBar(document.getElementById('gen-t9-filter-bar'));

const t9GenCatPill = t9GenBar.addPill('Категория', [
  { value: 'alternating',  label: 'чередующиеся' },
  { value: 'verifiable',   label: 'проверяемые' },
  { value: 'unverifiable', label: 'непроверяемые' },
], { multi: true });


const t9GenTasksCount = t9GenBar.addNumberPill('Заданий', 1, { min: 1, max: 20 });


let t9GenAltTypeRules = {};
let t9GenSelectedTypes = new Set();
let t9GenSelectedRoots = new Set();

(async function loadT9AltTypes() {
  try {
    t9GenAltTypeRules = await fetch('/api/task9/alternation-types').then(r => r.json());
    renderT9GenRootChips();
  } catch (_) {}
})();

t9GenCatPill.el.addEventListener('change', () => {
  const show = t9GenCatPill.getValues().includes('alternating');
  document.getElementById('gen-t9-alt-filters').style.display = show ? '' : 'none';
  if (!show) {
    t9GenSelectedTypes.clear(); t9GenSelectedRoots.clear();
    document.querySelectorAll('#gen-t9-type-chips .toggle-chip').forEach(c => c.classList.remove('active'));
  }
});

document.getElementById('gen-t9-type-chips').addEventListener('click', e => {
  const chip = e.target.closest('.toggle-chip[data-type]');
  if (!chip) return;
  const t = chip.dataset.type;
  if (t9GenSelectedTypes.has(t)) { t9GenSelectedTypes.delete(t); chip.classList.remove('active'); }
  else { t9GenSelectedTypes.add(t); chip.classList.add('active'); }
  pruneT9GenRoots();
  renderT9GenRootChips();
});

function t9GenVisibleRoots() {
  if (!t9GenSelectedTypes.size) return Object.values(t9GenAltTypeRules).flat();
  return [...t9GenSelectedTypes].flatMap(t => t9GenAltTypeRules[t] || []);
}
function pruneT9GenRoots() {
  const visible = new Set(t9GenVisibleRoots());
  for (const r of [...t9GenSelectedRoots]) { if (!visible.has(r)) t9GenSelectedRoots.delete(r); }
}
function renderT9GenRootChips() {
  const container = document.getElementById('gen-t9-root-chips');
  container.innerHTML = t9GenVisibleRoots().map(r => {
    const active = t9GenSelectedRoots.has(r) ? ' active' : '';
    return `<button class="toggle-chip toggle-chip-root${active}" data-root="${r}">${r}</button>`;
  }).join('');
}
document.getElementById('gen-t9-root-chips').addEventListener('click', e => {
  const chip = e.target.closest('.toggle-chip[data-root]');
  if (!chip) return;
  const r = chip.dataset.root;
  if (t9GenSelectedRoots.has(r)) { t9GenSelectedRoots.delete(r); chip.classList.remove('active'); }
  else { t9GenSelectedRoots.add(r); chip.classList.add('active'); }
});

document.getElementById('gen-btn-task9').addEventListener('click', async () => {
  const btn = document.getElementById('gen-btn-task9');
  btn.disabled = true; btn.textContent = 'Генерируем...';
  try {
    const categories = t9GenCatPill.getValues();
    const body = { is_practice: true };
    if (categories.length) body.categories = categories;
    body.tasks_count = t9GenTasksCount.getValue();
    if (categories.includes('alternating')) {
      if (t9GenSelectedRoots.size) body.alternation_rules = [...t9GenSelectedRoots];
      else if (t9GenSelectedTypes.size) body.alternation_types = [...t9GenSelectedTypes];
    }
    const res = await fetch('/api/task9/generate', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    const data = await res.json();
    if (!res.ok || data.error) { alert(data.error || ('Ошибка: ' + res.status)); return; }
    location.href = '/task9/' + data.id;
  } catch (err) {
    alert('Ошибка: ' + err.message);
  } finally {
    btn.disabled = false; btn.textContent = 'Сгенерировать';
  }
});

