  { value: 'наречие',           label: 'наречие' },
  { value: 'о/ё после шипящей', label: 'о/ё после шипящей' },
], { multi: true });

const t11GenCatPill = t11GenBar.addPill('Категория', [
  { value: 'variable', label: 'изменяемая' },
  { value: 'fixed',    label: 'неизменяемая' },
], { multi: true });

const t11GenRulesPill = t11GenBar.addPill('Правила', t11ComputeRules([], []), { multi: true });
t11GenRulesPill._dropdown.classList.add('task-filter-dropdown--two-col');

const t11GenTasksCount = t11GenBar.addNumberPill('Заданий', 1, { min: 1, max: 20 });

function t11UpdateRulesOptions() {
  t11GenRulesPill.updateOptions(t11ComputeRules(t11GenPosPill.getValues(), t11GenCatPill.getValues()));
}
t11GenPosPill.el.addEventListener('change', t11UpdateRulesOptions);
t11GenCatPill.el.addEventListener('change', t11UpdateRulesOptions);

document.getElementById('gen-btn-task11').addEventListener('click', async () => {
  const btn = document.getElementById('gen-btn-task11');
