<script>
(function initTheoryLocks() {
  const LS_KEY = 'theory_unlocked';
  function lsGet() { try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; } }
  function lsAdd(key) { const arr = lsGet(); if (!arr.includes(key)) { arr.push(key); localStorage.setItem(LS_KEY, JSON.stringify(arr)); } }

  let unlocked = [...lsGet()];

  function applyCardStates() {
    document.querySelectorAll('.t9th-lockable').forEach(card => {
      const key = card.dataset.theoryKey;
      if (unlocked.includes(key)) {
        card.classList.add('is-unlocked'); card.classList.remove('is-locked');
      } else {
        card.classList.add('is-locked');
      }
    });
  }

  applyCardStates();
  fetch('/api/theory/unlocks').then(r => r.ok ? r.json() : {}).then(d => {
    (d.unlocked || []).forEach(k => { if (!unlocked.includes(k)) unlocked.push(k); });
    applyCardStates();
  }).catch(() => {});

  function doUnlock(key) {
    lsAdd(key);
    fetch('/api/theory/unlock', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ theory_key: key }) }).catch(() => {});
  }

  document.querySelectorAll('.t9th-lockable').forEach(card => {
    card.addEventListener('click', () => {
      const key = card.dataset.theoryKey;
      const href = card.dataset.href;
      if (card.classList.contains('is-unlocked')) { location.href = href; return; }

      const modal = document.getElementById('theory-unlock-modal');
      modal.style.display = 'flex';

      const onConfirm = () => { cleanup(); doUnlock(key); card.classList.remove('is-locked'); card.classList.add('is-unlocked'); location.href = href; };
      const onCancel  = () => { cleanup(); modal.style.display = 'none'; };
      function cleanup() {
        document.getElementById('theory-unlock-confirm').removeEventListener('click', onConfirm);
        document.getElementById('theory-unlock-cancel').removeEventListener('click', onCancel);
      }
      document.getElementById('theory-unlock-confirm').addEventListener('click', onConfirm);
      document.getElementById('theory-unlock-cancel').addEventListener('click', onCancel);
    });
  });
})();
fetch('/api/progress/theory/view', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ task_key: 'task9' }) }).catch(() => {});
</script>
