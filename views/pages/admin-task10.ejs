/* ─── ИЗ ТЕКСТА ──────────────────────────────── */

// Буквы, по которым правило определяется однозначно
const LETTER_TO_RULE10 = {
  'ъ': 'ъ/ь', 'ь': 'ъ/ь',
  'з': 'з/с',  'с': 'з/с',
  'е': 'пре/при',
  'ы': 'ы/и',
};

function ftAutoFillRule(input) {
  const wordEl = input.closest('.ft-word');
  const ruleEl = wordEl.querySelector('.ft-rule');
  if (ruleEl.dataset.manual === '1') return; // пользователь уже выбрал вручную

  const letter = input.value.trim().toLowerCase().slice(-1);

  // Прямое однозначное соответствие
  let rule = LETTER_TO_RULE10[letter] || '';

  // Для и/о/а берём правило от соседнего слова в строке
  if (!rule) {
    const rowEl = wordEl.closest('.ft-row');
    for (const r of rowEl.querySelectorAll('.ft-rule')) {
      if (r !== ruleEl && r.value) { rule = r.value; break; }
    }
  }

  if (rule) ruleEl.value = rule;
}

// Когда пользователь вручную выбирает правило — распространяем на соседей без правила и перепроверяем строку
function ftPropagateRule(ruleEl) {
  const rowEl = ruleEl.closest('.ft-row');
  const rule = ruleEl.value;
  if (!rule) return;
  for (const r of rowEl.querySelectorAll('.ft-rule')) {
    if (r !== ruleEl && !r.value) r.value = rule;
  }
  ftCheckRowCorrectness(rowEl);
}

const FT10_RULE_OPT = `<option value="">— правило —</option>
<option value="ъ/ь">ъ / ь разделительные</option>
<option value="з/с">з / с чередование</option>
<option value="пре/при">пре / при</option>
<option value="пра/про">пра / про</option>
<option value="ы/и">ы / и после приставки</option>
<option value="неизменяемые гласные">Неизменяемые (гласные)</option>
<option value="неизменяемые согласные">Неизменяемые (согласные)</option>`;

function ftLookupWord(display) {
  const norm = display.toLowerCase().trim();
  let w = allWords.find(w => w.prefix_display.toLowerCase() === norm);
  if (w) return w;
  const bare = norm.replace(/\s*\([^)]*\)\s*$/, '').trim();
  if (bare !== norm) w = allWords.find(w => w.prefix_display.toLowerCase() === bare || w.prefix_display.toLowerCase() === norm);
  return w || null;
}

function ftParse() {
  const text = document.getElementById('ft-input').value;
  const status = document.getElementById('ft-parse-status');
  const parsed = [];
  for (const line of text.trim().split('\n')) {
    const m = line.trim().match(/^(\d+)[).]\s*(.+)/);
    if (!m) continue;
    const rowNum = parseInt(m[1], 10);
    const words = m[2].split(',').map(w => w.trim()).filter(Boolean);
    parsed.push({ rowNum, isCorrect: false, words: words.map(d => ({ display: d, found: ftLookupWord(d) })) });
  }
  if (!parsed.length) {
    status.textContent = 'Не удалось распознать строки. Проверьте формат.';
    status.style.color = 'var(--color-error)';
    return;
  }
  for (const row of parsed) {
    const found = row.words.filter(w => w.found);
    if (found.length === row.words.length && found.length > 0) {
      const letters = found.map(w => w.found.correct_letter.toLowerCase());
      row.isCorrect = letters.every(v => v === letters[0]);
    }
  }
  window._ftParsedRows = parsed;
  const foundCount = parsed.flatMap(r => r.words).filter(w => w.found).length;
  const total = parsed.flatMap(r => r.words).length;
  status.textContent = `Строк: ${parsed.length} · найдено в словаре: ${foundCount} из ${total}`;
  status.style.color = 'var(--text-secondary)';
  ftRenderPreview(parsed);
  document.getElementById('ft-preview').style.display = '';
}

function ftRenderPreview(parsed) {
  const container = document.getElementById('ft-rows');
  container.innerHTML = '';
  for (const row of parsed) {
    const div = document.createElement('div');
    div.className = 'ft-row' + (row.isCorrect ? ' correct-row' : '');
    div.dataset.rowNum = row.rowNum;
    const wordsHtml = row.words.map((w) => {
      if (w.found) {
        return `<div class="ft-word ft-word--found" data-word-id="${w.found.id}">
          <span class="ft-word-label">${escHtml(w.display)}</span>
          <span class="ft-found-info">«${escHtml(w.found.correct_letter)}» · ${escHtml(w.found.rule)}</span>
        </div>`;
      }
      return `<div class="ft-word ft-word--missing">
        <span class="ft-word-label">${escHtml(w.display)}</span>
        <div class="ft-missing-form">
          <div class="ft-missing-row">
            <input type="text" maxlength="2" class="ft-letter-inp" placeholder="·"
              title="Правильная буква (оставьте пустым если знак не нужен)"
              oninput="ftAutoFillRule(this); ftCheckRowCorrectness(this.closest('.ft-row'))">
            <select class="ft-rule" style="flex:1;" onchange="this.dataset.manual='1'; ftPropagateRule(this)">${FT10_RULE_OPT}</select>
          </div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;">Пусто = знак не нужен</div>
        </div>
      </div>`;
    }).join('');
    div.innerHTML = `
      <div class="ft-row-header">
        <span style="font-size:13px;font-weight:600;color:var(--text-secondary);min-width:60px;">Строка ${row.rowNum}</span>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;font-weight:500;">
          <input type="checkbox" class="ft-correct-cb" ${row.isCorrect ? 'checked' : ''}
            onchange="this.closest('.ft-row').classList.toggle('correct-row',this.checked)">
          правильная строка
        </label>
      </div>
      <div class="ft-words">${wordsHtml}</div>`;
    container.appendChild(div);
    ftCheckRowCorrectness(div);
  }
}

function ftCheckRowCorrectness(rowEl) {
  if (!rowEl) return;
  const letters = [];
  for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
    if (wordEl.dataset.wordId) {
      const w = allWords.find(w => w.id === +wordEl.dataset.wordId);
      if (!w) return;
      letters.push((w.correct_letter || '').toLowerCase());
    } else {
      const inp = wordEl.querySelector('.ft-letter-inp');
      const letter = (inp?.value ?? '').trim().toLowerCase();
      // Если буква не введена и правило не выбрано — слово ещё не заполнено, ждём
      const rule = wordEl.querySelector('.ft-rule')?.value;
      if (!letter && !rule) return;
      letters.push(letter);
    }
  }
  if (letters.length !== 3) return;
  const allSame = letters.every(l => l === letters[0]);
  const cb = rowEl.querySelector('.ft-correct-cb');
  if (cb) { cb.checked = allSame; rowEl.classList.toggle('correct-row', allSame); }
}

async function ftCreate() {
  const btn = document.getElementById('ft-create-btn');
  const status = document.getElementById('ft-create-status');
  btn.disabled = true;
  status.style.color = 'var(--text-secondary)';
  status.textContent = '';
  try {
    const rowEls = document.querySelectorAll('#ft-rows .ft-row');
    if (rowEls.length !== 5) throw new Error(`Нужно ровно 5 строк (сейчас: ${rowEls.length})`);
    const rows = [];
    for (const rowEl of rowEls) {
      const rowNum = +rowEl.dataset.rowNum;
      const isCorrect = rowEl.querySelector('.ft-correct-cb').checked;
      const wordIds = [];
      for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
        if (wordEl.dataset.wordId) { wordIds.push(+wordEl.dataset.wordId); continue; }
        const display = wordEl.querySelector('.ft-word-label').textContent.trim();
        const letter  = (wordEl.querySelector('.ft-letter-inp')?.value || '').trim().toLowerCase();
        const rule    = wordEl.querySelector('.ft-rule')?.value;
        if (!rule)   throw new Error(`«${display}»: выберите правило`);
        status.textContent = `Добавляем «${display}» в словарь…`;
        const res = await fetch('/api/task10/words', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prefix_display: display, correct_letter: letter, rule })
        });
        const data = await res.json();
        if (data.error) throw new Error(`«${display}»: ${data.error}`);
        wordEl.dataset.wordId = data.id;
        wordIds.push(data.id);
      }
      if (wordIds.length !== 3) throw new Error(`Строка ${rowNum}: нужно 3 слова`);
      rows.push({ row_index: rowNum, is_correct: isCorrect, word_ids: wordIds });
    }
    const correctCount = rows.filter(r => r.is_correct).length;
    if (correctCount < 2 || correctCount > 5) throw new Error('Отметьте от 2 до 5 правильных строк');
    status.textContent = 'Сохраняем задание…';
    const res = await fetch('/api/task10/tasks', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rows })
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    status.style.color = '';
    status.innerHTML = `<span style="color:var(--color-success);">✓ Задание #${data.id} создано.
      <a href="/task10/${data.id}" target="_blank" style="color:inherit;text-decoration:underline;">Открыть →</a></span>`;
    document.getElementById('ft-preview').style.display = 'none';
    document.getElementById('ft-input').value = '';
    document.getElementById('ft-parse-status').textContent = '';
    await loadWords();
  } catch (err) {
    status.style.color = 'var(--color-error)';
    status.textContent = err.message;
  } finally {
    btn.disabled = false;
  }
}

loadWords();
</script>
