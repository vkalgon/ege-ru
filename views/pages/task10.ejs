<div class="task-page">
  <h2 class="task-page__title">Задание №10 — Правописание приставок</h2>

  <div class="task17-wrapper">
    <div class="task9-column">

  <div>
    <div id="tasks-list" class="task10-task-feed">
      <p style="color:var(--text-secondary);">Загрузка...</p>
    </div>
  </div>

    </div>
  </div>
</div>

<style>
.task10-check-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 8px 12px;
  padding: 12px;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  background: var(--bg-secondary);
  box-sizing: border-box;
  flex: 1;
}
.task10-check-grid label {
  display: flex;
  gap: 8px;
  align-items: center;
  font-size: 14px;
}
.task10-check-grid input[type="checkbox"] {
  appearance: auto;
  -webkit-appearance: checkbox;
  width: 16px;
  height: 16px;
  min-width: 16px;
  margin: 0;
  padding: 0;
  border: initial;
  border-radius: 3px;
  background: initial;
  box-shadow: none;
  accent-color: var(--brand);
}
.task10-count-grid {
  min-width: 200px;
  grid-template-columns: 1fr;
}
.task10-generate-grid > .form-group {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.task10-task-feed {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.task10-generate-grid {
  display: grid;
  grid-template-columns: minmax(320px, 1fr) minmax(200px, 260px);
  gap: 12px;
  align-items: stretch;
}
.task10-generate-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16px;
}
.task10-generate-wrap {
  padding-left: 0;
}
.task10-section-title {
  margin: 0 0 16px;
  font-size: 16px;
  font-weight: 600;
}
@media (max-width: 700px) {
  .task10-generate-grid {
    grid-template-columns: 1fr;
  }
  .task10-generate-actions {
    justify-content: flex-start;
  }
}
</style>

<script src="/js/task-play-card.js"></script>
<script>
/* ── Tasks feed ── */
async function loadTasks() {
  const res = await fetch('/api/task10/tasks');
  const tasks = await res.json();
  const list = document.getElementById('tasks-list');
  if (!tasks.length) {
    list.innerHTML = '<p style="color:var(--text-secondary);">Пока нет заданий.</p>';
    return;
  }
  const plays = await Promise.all(
    tasks.map((t) => fetch('/api/task10/tasks/' + t.id + '/play').then((r) => (r.ok ? r.json() : null)))
  );
  const blocks = [];
  for (let i = 0; i < tasks.length; i++) {
    const t = tasks[i];
    const play = plays[i];
    if (!play) continue;
    blocks.push(
      '<div class="task10-feed-item" id="task10-feed-' + t.id + '">' +
        renderTask10CardHTML(t.id, play, { standalone: false }) +
      '</div>'
    );
  }
  if (!blocks.length) {
    list.innerHTML = '<p style="color:var(--text-secondary);">Не удалось загрузить содержимое заданий.</p>';
    return;
  }
  list.innerHTML = blocks.join('');
  for (let i = 0; i < tasks.length; i++) {
    const t = tasks[i];
    const play = plays[i];
    if (!play) continue;
    const root = document.getElementById('task10-feed-' + t.id);
    if (root) initTask10Card(root, t.id, play, { standalone: false });
  }
}

loadTasks();
</script>
