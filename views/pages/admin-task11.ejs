/* ─── ИЗ ТЕКСТА ──────────────────────────────── */

const FT11_RULES = {
  'глагол': {
    'variable': [
      ['ова/ыва',  '-ова-/-ева- vs -ыва-/-ива-'],
      ['перед_вш', 'гласная перед -вш-/-л-/-в-'],
      ['обес/обез','обес-/обез-']
    ]
  },
  'прилагательное': {
    'variable': [['ев/ив','-ев-/-ив-'],['к/ск','-к-/-ск-'],['ян/ен','-ян-/-ен-'],['ач/еч','-ач-/-еч-'],['ин/ен','-ин-/-ен-']],
    'fixed':    [['лив/чив','-лив-/-чив-'],['еньк/оньк','-еньк-/-оньк-'],['еват/оват','-еват-/-оват-'],['ист','-ист-'],['чат','-чат-']]
  },
  'существительное': {
    'variable': [['ик/ек','-ик- vs -ек-'],['ец/иц','-ец- vs -иц-'],['чик/щик','-чик-/-щик-'],['инк/енк','-инк- / -енк-'],['ичк/ечк','-ичк- / -ечк-']],
    'fixed':    [['изн/от/ин','-изн-/-от-/-ин-']]
  },
  'наречие': {
    'fixed': [['о/а_нар','о/а в наречиях']]
  },
  'о/ё после шипящей': {
    'fixed': [
      ['о/ё_ё_гл','ё — от глагола'],
      ['о/ё_ё_ёр','ё — суффикс -ёр-'],
      ['о/ё_о','о']
    ]
  }
};

const VOWEL_TO_PAIR11 = { 'а':'о/а','о':'о/а','е':'е/и','и':'е/и','ы':'и/ы','ю':'у/ю','у':'у/ю','ё':'о/ё','я':'е/я' };

function ft11AutoFillPair(letterInp) {
  const pairInp = letterInp.closest('.ft-missing-form').querySelector('.ft-pair-inp');
  if (pairInp.dataset.manual) return;
  const letter = letterInp.value.trim().toLowerCase().slice(-1);
  const pair = VOWEL_TO_PAIR11[letter] || '';
  if (pair) pairInp.value = pair;
}

function ft11OnPosChange(posEl) {
  const form = posEl.closest('.ft-missing-form');
  const catSel    = form.querySelector('.ft-cat-sel');
  const suffixSel = form.querySelector('.ft-suffix-sel');
  const pos = posEl.value;
  catSel.value = '';
  catSel.style.display = 'none';
  suffixSel.innerHTML = '<option value="">— правило —</option>';
  suffixSel.style.display = 'none';
  if (!pos) return;
  const cats = Object.keys(FT11_RULES[pos] || {});
  if (cats.length === 1) {
    catSel.value = cats[0];
    ft11UpdateRules(suffixSel, pos, cats[0]);
  } else {
    catSel.style.display = '';
  }
}

function ft11OnCatChange(catEl) {
  const form = catEl.closest('.ft-missing-form');
  const pos = form.querySelector('.ft-pos-sel').value;
  ft11UpdateRules(form.querySelector('.ft-suffix-sel'), pos, catEl.value);
}

function ft11UpdateRules(suffixSel, pos, cat) {
  const rules = (FT11_RULES[pos] || {})[cat] || [];
  suffixSel.innerHTML = '<option value="">— правило —</option>' +
    rules.map(([v, l]) => `<option value="${escHtml(v)}">${escHtml(l)}</option>`).join('');
  suffixSel.style.display = rules.length ? '' : 'none';
}

function ft11GuessPosFromEnding(wordLower) {
  if (/(ть|тся|ться)$/.test(wordLower)) return 'глагол';
  if (wordLower.length >= 4 && /(лись|лась|лось|лся|ли|ла|ло|л)$/.test(wordLower)) return 'глагол';
  if (/(ый|ий|ой|ая|яя|ое|ее|ые|ие)$/.test(wordLower)) return 'прилагательное';
  return null;
}

function ft11GuessFromWordSuffix(word) {
  const w = word.toLowerCase();
  if (/(ы|о|е|и)ва(ть|ться)$/.test(w))         return { pos: 'глагол',         cat: 'variable', rule: 'ова/ыва'   };
  if (/(о|е)ват(ый|ая|ое|ые|ом|ой|ого|ому)?$/.test(w)) return { pos: 'прилагательное', cat: 'fixed',    rule: 'еват/оват' };
  if (/(ч|щ)ик$/.test(w))                       return { pos: 'существительное', cat: 'variable', rule: 'чик/щик'  };
  return null;
}

function ft11ParseToken(raw) {
  const withoutParens = raw.replace(/\([^)]*\)/g, () => ' ').replace(/\s+/g, ' ').trim();
  const word = withoutParens.split(/\s+/).filter(Boolean)[0] || '';
  const upperMatch = word.match(/[А-ЯЁ]/);
  const correctLetter = upperMatch ? upperMatch[0].toLowerCase() : null;
  // Build the suffix_display form (.. instead of answer letter, plus context parens)
  const dotWord = correctLetter
    ? word.replace(/[А-ЯЁ]/, '..').toLowerCase()
    : word.toLowerCase();
  const rawParens = raw.match(/\([^)]*\)/g);
  const dotDisplay = rawParens ? dotWord + ' ' + rawParens.join(' ') : dotWord;
  const suffixGuess = ft11GuessFromWordSuffix(word);
  const guessedPos  = suffixGuess?.pos  || ft11GuessPosFromEnding(word.toLowerCase());
  const guessedCat  = suffixGuess?.cat  || null;
  const guessedRule = suffixGuess?.rule || null;
  return { wordLower: word.toLowerCase(), displayWord: word, correctLetter, guessedPos, guessedCat, guessedRule, dotDisplay };
}

function ft11AutoDetectRule(letterInp) {
  const letter = letterInp.value.trim().toLowerCase();
  const form    = letterInp.closest('.ft-missing-form');
  const posSel  = form.querySelector('.ft-pos-sel');
  const catSel  = form.querySelector('.ft-cat-sel');
  const suffSel = form.querySelector('.ft-suffix-sel');
  if (posSel.dataset.manual || suffSel.dataset.manual) return;

  let pos = null, cat = null, rule = null;
  if (letter === 'ч' || letter === 'щ') {
    pos = 'существительное'; cat = 'variable'; rule = 'чик/щик';
  } else if (letter === 'с') {
    const gPos = letterInp.closest('.ft-word')?.dataset.guessedPos || posSel.value;
    if (!gPos || gPos === 'прилагательное') {
      pos = 'прилагательное'; cat = 'variable'; rule = 'к/ск';
    }
  }
  if (!pos) return;

  if (posSel.value !== pos) { posSel.value = pos; ft11OnPosChange(posSel); }
  if (cat && catSel.style.display !== 'none' && catSel.value !== cat) { catSel.value = cat; ft11OnCatChange(catSel); }
  if (rule && suffSel.value !== rule) suffSel.value = rule;
}

function ftLookupWord(display) {
  const norm = display.toLowerCase().trim();
  let w = allWords.find(w => w.suffix_display.toLowerCase() === norm);
  if (w) return w;
  const bare = norm.replace(/\s*\([^)]*\)/g, '').trim();
  if (bare !== norm) {
    w = allWords.find(w => {
      const wBare = w.suffix_display.toLowerCase().replace(/\s*\([^)]*\)/g, '').trim();
      return wBare === bare || w.suffix_display.toLowerCase() === norm;
    });
  }
  return w || null;
}

function ftLookupWordFull(fullWord) {
  const needle = fullWord.toLowerCase().replace(/\s*\([^)]*\)/g, '').trim();
  return allWords.find(w => {
    const bare = w.suffix_display.toLowerCase().replace(/\s*\([^)]*\)/g, '').trim();
    const full = bare.replace('..', (w.correct_vowel || '').toLowerCase());
    return full === needle;
  }) || null;
}

function ftParse() {
  const text = document.getElementById('ft-input').value;
  const status = document.getElementById('ft-parse-status');
  const parsed = [];
  for (const line of text.trim().split('\n')) {
    const m = line.trim().match(/^(\d+)[).]\s*(.+)/);
    if (!m) continue;
    const rowNum = parseInt(m[1], 10);
    const tokens = m[2].split(',').map(t => t.trim()).filter(Boolean);
    parsed.push({ rowNum, isCorrect: false, words: tokens.map(raw => {
      const p = ft11ParseToken(raw);
      const found = ftLookupWord(raw) || ftLookupWord(p.wordLower) || ftLookupWordFull(p.wordLower);
      return {
        display:     p.dotDisplay || raw.toLowerCase().trim(), // word with dots + context parens — stored in DB
        fullDisplay: raw.trim(),                               // full text as typed — shown in UI
        found, hints: found ? null : p
      };
    })});
  }
  if (!parsed.length) {
    status.textContent = 'Не удалось распознать строки. Проверьте формат.';
    status.style.color = 'var(--color-error)';
    return;
  }
  for (const row of parsed) {
    const letters = row.words.map(w =>
      w.found ? (w.found.correct_vowel || '').toLowerCase()
              : (w.hints?.correctLetter ?? null)
    );
    if (letters.every(l => l !== null)) {
      row.isCorrect = letters.every(l => l === letters[0]);
    }
  }
  window._ftParsedRows = parsed;
  const foundCount = parsed.flatMap(r => r.words).filter(w => w.found).length;
  const total = parsed.flatMap(r => r.words).length;
  status.textContent = `Строк: ${parsed.length} · найдено в словаре: ${foundCount} из ${total}`;
  status.style.color = 'var(--text-secondary)';
  ftRenderPreview(parsed);
  document.getElementById('ft-preview').style.display = '';
}

function ftRenderPreview(parsed) {
  const container = document.getElementById('ft-rows');
  container.innerHTML = '';
  for (const row of parsed) {
    const div = document.createElement('div');
    div.className = 'ft-row' + (row.isCorrect ? ' correct-row' : '');
    div.dataset.rowNum = row.rowNum;
    const wordsHtml = row.words.map((w) => {
      if (w.found) {
        return `<div class="ft-word ft-word--found" data-word-id="${w.found.id}">
          <span class="ft-word-label">${escHtml(w.fullDisplay || w.display)}</span>
          <span class="ft-found-info">«${escHtml(w.found.correct_vowel || '—')}» · ${escHtml(w.found.suffix)}</span>
        </div>`;
      }
      const h = w.hints || {};
      const hLetter = h.correctLetter || '';
      const hPair   = hLetter ? (VOWEL_TO_PAIR11[hLetter] || '') : '';
      const hPos    = h.guessedPos  || '';
      const hCat    = h.guessedCat  || '';
      const hRule   = h.guessedRule || '';
      const posCats = hPos ? Object.keys(FT11_RULES[hPos] || {}) : [];
      const effCat  = hCat || (posCats.length === 1 ? posCats[0] : '');
      const catSty  = (hPos && posCats.length > 1) ? '' : 'display:none';
      const suffRules = (hPos && effCat) ? ((FT11_RULES[hPos] || {})[effCat] || []) : [];
      const suffOpts  = '<option value="">— правило —</option>' +
        suffRules.map(([v, l]) => `<option value="${escHtml(v)}"${v === hRule ? ' selected' : ''}>${escHtml(l)}</option>`).join('');
      const suffSty   = suffRules.length ? '' : 'display:none';
      return `<div class="ft-word ft-word--missing" data-guessed-pos="${escHtml(hPos)}">
        <span class="ft-word-label" data-word="${escHtml(w.display)}">${escHtml(w.fullDisplay || w.display)}</span>
        <div class="ft-missing-form">
          <div class="ft-missing-row">
            <input type="text" maxlength="2" class="ft-letter-inp" placeholder="·"
              title="Правильная буква" value="${escHtml(hLetter)}"
              oninput="ft11AutoFillPair(this);ft11AutoDetectRule(this);ftCheckRowCorrectness(this.closest('.ft-row'))">
            <input type="text" class="ft-pair-inp" placeholder="пара (о/ы)" style="flex:1;"
              value="${escHtml(hPair)}" oninput="this.dataset.manual='1'">
          </div>
          <select class="ft-pos-sel" onchange="ft11OnPosChange(this)">
            <option value="">— часть речи —</option>
            ${['глагол','прилагательное','существительное','наречие','о/ё после шипящей'].map(p =>
              `<option value="${p}"${p === hPos ? ' selected' : ''}>${p}</option>`).join('')}
          </select>
          <select class="ft-cat-sel" style="${catSty}" onchange="ft11OnCatChange(this)">
            <option value="">— изм./неизм. —</option>
            <option value="variable"${effCat === 'variable' ? ' selected' : ''}>изменяемая</option>
            <option value="fixed"${effCat === 'fixed' ? ' selected' : ''}>неизменяемая</option>
          </select>
          <select class="ft-suffix-sel" style="${suffSty}">${suffOpts}</select>
        </div>
      </div>`;
    }).join('');
    div.innerHTML = `
      <div class="ft-row-header">
        <span style="font-size:13px;font-weight:600;color:var(--text-secondary);min-width:60px;">Строка ${row.rowNum}</span>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;font-weight:500;">
          <input type="checkbox" class="ft-correct-cb" ${row.isCorrect ? 'checked' : ''}
            onchange="this.closest('.ft-row').classList.toggle('correct-row',this.checked)">
          правильная строка
        </label>
      </div>
      <div class="ft-words">${wordsHtml}</div>`;
    container.appendChild(div);
  }
}

function ftCheckRowCorrectness(rowEl) {
  if (!rowEl) return;
  const vowels = [];
  for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
    if (wordEl.dataset.wordId) {
      const w = allWords.find(w => w.id === +wordEl.dataset.wordId);
      if (!w) return;
      vowels.push((w.correct_vowel || '').toLowerCase());
    } else {
      const inp = wordEl.querySelector('.ft-letter-inp');
      if (!inp) return;
      const v = inp.value.trim().toLowerCase().slice(-1);
      const isKSK = wordEl.querySelector('.ft-suffix-sel')?.value === 'к/ск';
      if (!v && !isKSK) return;
      vowels.push(v);
    }
  }
  if (vowels.length !== 2) return;
  const allSame = vowels.every(v => v === vowels[0]);
  const cb = rowEl.querySelector('.ft-correct-cb');
  if (cb) { cb.checked = allSame; rowEl.classList.toggle('correct-row', allSame); }
}

async function ftCreate() {
  const btn = document.getElementById('ft-create-btn');
  const status = document.getElementById('ft-create-status');
  btn.disabled = true;
  status.style.color = 'var(--text-secondary)';
  status.textContent = '';
  try {
    const rowEls = document.querySelectorAll('#ft-rows .ft-row');
    if (rowEls.length !== 5) throw new Error(`Нужно ровно 5 строк (сейчас: ${rowEls.length})`);
    const rows = [];
    for (const rowEl of rowEls) {
      const rowNum = +rowEl.dataset.rowNum;
      const isCorrect = rowEl.querySelector('.ft-correct-cb').checked;
      const wordIds = [];
      for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
        if (wordEl.dataset.wordId) { wordIds.push(+wordEl.dataset.wordId); continue; }
        const labelEl      = wordEl.querySelector('.ft-word-label');
        const display      = labelEl.dataset.word || labelEl.textContent.trim();
        const correct_vowel = (wordEl.querySelector('.ft-letter-inp')?.value || '').trim().toLowerCase().slice(-1);
        const vowel_pair   = (wordEl.querySelector('.ft-pair-inp')?.value || '').trim();
        const suffix       = wordEl.querySelector('.ft-suffix-sel')?.value;
        const part_of_speech = wordEl.querySelector('.ft-pos-sel')?.value;
        const category     = wordEl.querySelector('.ft-cat-sel')?.value;
        if (!correct_vowel && suffix !== 'к/ск') throw new Error(`«${display}»: укажите правильную букву`);
        if (!suffix)         throw new Error(`«${display}»: выберите правило`);
        if (!part_of_speech) throw new Error(`«${display}»: выберите часть речи`);
        if (!category)       throw new Error(`«${display}»: выберите категорию`);
        status.textContent = `Добавляем «${display}» в словарь…`;
        const res = await fetch('/api/task11/words', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ suffix_display: display, correct_vowel, vowel_pair, suffix, part_of_speech, category })
        });
        const data = await res.json();
        if (data.error) throw new Error(`«${display}»: ${data.error}`);
        wordEl.dataset.wordId = data.id;
        wordIds.push(data.id);
      }
      if (wordIds.length !== 2) throw new Error(`Строка ${rowNum}: нужно 2 слова`);
      rows.push({ row_index: rowNum, is_correct: isCorrect, word_ids: wordIds });
    }
    const correctCount = rows.filter(r => r.is_correct).length;
    if (correctCount < 2 || correctCount > 5) throw new Error('Отметьте от 2 до 5 правильных строк');
    status.textContent = 'Сохраняем задание…';
    const res = await fetch('/api/task11/tasks', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rows })
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    status.style.color = '';
    status.innerHTML = `<span style="color:var(--color-success);">✓ Задание #${data.id} создано.
      <a href="/task11/${data.id}" target="_blank" style="color:inherit;text-decoration:underline;">Открыть →</a></span>`;
    document.getElementById('ft-preview').style.display = 'none';
    document.getElementById('ft-input').value = '';
    document.getElementById('ft-parse-status').textContent = '';
    await loadWords();
  } catch (err) {
    status.style.color = 'var(--color-error)';
    status.textContent = err.message;
  } finally {
    btn.disabled = false;
  }
}

loadWords();
</script>
