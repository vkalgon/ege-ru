        <button type="button" class="btn btn-ghost btn-sm" id="t10th-zs-restart">Новая серия</button>
      </div>
    </div>
  </div>
</div>

<style>
.t10th-block {
  border: 1px solid var(--glass-border);
  border-radius: 14px;
  background: var(--bg-secondary);
  overflow: hidden;
  transition: border-color .2s;
}
.t10th-block--open { border-color: var(--glass-border); }

.t10th-lockable { cursor: pointer; }
.t10th-lockable:hover { border-color: var(--brand); }
.t10th-lockable.is-unlocked { cursor: default; }

.t10th-block-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  user-select: none;
}
.t10th-block--open .t10th-block-head,
.t10th-lockable.is-unlocked .t10th-block-head { padding-bottom: 0; }

.t10th-open-arrow { color: var(--text-secondary); font-size: 14px; margin-left: auto; }

/* замок */
.t10th-lock-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 6px;
  padding: 3px 8px;
  margin-left: auto;
}
.t10th-lockable.is-locked { opacity: 0.78; }
.t10th-lockable.is-locked:hover { opacity: 1; }

/* body */
.t10th-block-body {
  padding: 14px 20px 20px;
  display: none;
}
.t10th-block--open .t10th-block-body,
.t10th-lockable.is-unlocked .t10th-block-body { display: block; }

/* section inner */
.t10th-rule-text { font-size: 14px; color: var(--text-secondary); margin: 0 0 16px; line-height: 1.6; }

.th-table tr:hover td { background: var(--bg-secondary); }

/* cards 2 col */
.t10th-cards-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
@media (max-width: 600px) { .t10th-cards-2 { grid-template-columns: 1fr; } }

.t10th-meaning-card {
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  padding: 16px 18px;
  background: var(--bg-primary);
}
.t10th-meaning-card--pri  { border-left: 1px solid #7ab8e2; }
.t10th-meaning-card--pre  { border-left: 1px solid #e2a07a; }
.t10th-meaning-card--y    { border-left: 1px solid #a7e27a; }
.t10th-meaning-card--hard { border-left: 1px solid #e2d07a; }
.t10th-meaning-card--soft { border-left: 1px solid #c07ae2; }
.t10th-meaning-card--pra  { border-left: 1px solid #7ae2c0; }
.t10th-meaning-card--pro  { border-left: 1px solid #7a8ce2; }

.t10th-mc-title { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 10px; }
.t10th-mc-list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
.t10th-mc-list li { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
.t10th-mc-hint { margin-top: 10px; font-size: 13px; color: var(--brand); font-weight: 500; }

/* z/s пары */
.t10th-pairs-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
@media (max-width: 500px) { .t10th-pairs-row { grid-template-columns: 1fr; } }
.t10th-pair-block { border-radius: 10px; padding: 14px 16px; border: 1px solid var(--glass-border); background: var(--bg-primary); }
.t10th-pair-block--z { border-top: 1px solid #7ab8e2; }
.t10th-pair-block--s { border-top: 1px solid #e2a07a; }
.t10th-pair-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--text-secondary); margin-bottom: 6px; }
.t10th-pair-letters { font-family: monospace; font-size: 15px; color: var(--text-primary); margin-bottom: 8px; letter-spacing: .1em; }
.t10th-pair-ex { font-size: 13px; font-weight: 600; color: var(--brand); }
.t10th-zs-open-btn { margin: 4px 0 2px; }
.t10th-zs-modal-box {
  background: var(--bg-primary);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  width: 100%;
  max-width: 900px;
