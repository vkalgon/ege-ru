}
.t10th-zs-feedback.is-ok { color: #3b9862; }
.t10th-zs-feedback.is-error { color: #c05d53; }
.t10th-zs-bottom { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
.t10th-zs-bottom .btn { min-width: 140px; justify-content: center; }

/* исключения пре/при */
.t10th-exceptions-block { border: 1px solid var(--glass-border); border-radius: 12px; padding: 16px 18px; background: var(--bg-primary); margin-top: 4px; }
.t10th-exc-title { font-size: 13px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 12px; }
.t10th-exc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 500px) { .t10th-exc-grid { grid-template-columns: 1fr; } }
.t10th-exc-colhead { font-size: 13px; font-weight: 700; color: var(--brand); margin-bottom: 6px; }
.t10th-exc-words { font-size: 13px; color: var(--text-secondary); line-height: 1.7; }

/* омофоны */
.t10th-omophone-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-secondary); margin-bottom: 8px; }
.t10th-omophone-table { border: 1px solid var(--glass-border); border-radius: 10px; overflow: hidden; }
.t10th-omophone-header { display: grid; grid-template-columns: 1fr 1fr; background: var(--bg-secondary); border-bottom: 1px solid var(--glass-border); }
.t10th-omophone-header > div { padding: 7px 12px; font-size: 12px; font-weight: 700; color: var(--brand); }
.t10th-omophone-header > div:first-child { border-right: 1px solid var(--glass-border); }
.t10th-omophone-row { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--glass-border); }
.t10th-omophone-row:last-child { border-bottom: none; }
.t10th-omophone-row > div { padding: 8px 12px; font-size: 13px; color: var(--text-primary); line-height: 1.45; }
.t10th-omophone-row > div:first-child { border-right: 1px solid var(--glass-border); }
.t10th-omophone-row:nth-child(odd) { background: var(--brand-hover); }
.t10th-om-hint { display: block; font-size: 11.5px; color: var(--text-secondary); margin-top: 2px; }
@media (max-width: 540px) {
  .t10th-omophone-header, .t10th-omophone-row { grid-template-columns: 1fr; }
  .t10th-omophone-header > div:first-child, .t10th-omophone-row > div:first-child { border-right: none; border-bottom: 1px solid var(--glass-border); }
}

/* tip / warn */
.t10th-tip, .t10th-warn {
  display: flex; gap: 10px; align-items: flex-start;
  padding: 12px 16px; border-radius: 10px;
  font-size: 13px; line-height: 1.55; margin-top: 12px;
}
.t10th-tip { background: var(--brand-hover); border: 1px solid var(--brand-ripple); color: var(--text-secondary); }
.t10th-warn { background: var(--warn-subtle); border: 1px solid var(--warn-border); color: var(--text-secondary); }
.t10th-tip-icon, .t10th-warn-icon { flex-shrink: 0; display: flex; align-items: center; margin-top: 1px; }
.t10th-tip .t10th-tip-icon { color: var(--brand); }
.t10th-warn .t10th-warn-icon { color: #e2a07a; }
.theory-unlock-icon { display: flex; justify-content: center; color: var(--brand); }
@media (max-width: 500px) {
  }

/* модал разблокировки */
.theory-unlock-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.theory-unlock-box {
  background: var(--bg-primary);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 28px 24px 22px;
  max-width: 340px;
  width: 100%;
  box-shadow: 0 8px 32px rgba(0,0,0,0.2);
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.theory-unlock-icon { font-size: 32px; text-align: center; }
.theory-unlock-title { font-size: 16px; font-weight: 700; color: var(--text-primary); text-align: center; margin: 0; }
.theory-unlock-desc { font-size: 13px; color: var(--text-secondary); text-align: center; line-height: 1.5; margin: 0; }
.theory-unlock-actions { display: flex; gap: 10px; margin-top: 4px; }
.theory-unlock-actions .btn { flex: 1; justify-content: center; border-radius: 50px; }
</style>

<script>
(function initT10Locks() {
  const LS_KEY = 'theory_unlocked';
  function lsGet() {
    try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; }
  }
  function lsAdd(key) {
    const arr = lsGet();
    if (!arr.includes(key)) { arr.push(key); localStorage.setItem(LS_KEY, JSON.stringify(arr)); }
  }

  let unlocked = [...lsGet()];
  applyStates();
  fetch('/api/theory/unlocks').then(r => r.ok ? r.json() : {}).then(d => {
    (d.unlocked || []).forEach(k => { if (!unlocked.includes(k)) unlocked.push(k); });
    applyStates();
  }).catch(() => { applyStates(); });

  function applyStates() {
    document.querySelectorAll('.t10th-lockable').forEach(card => {
      const key = card.dataset.key;
      if (unlocked.includes(key)) unlock(card, false);
      else card.classList.add('is-locked');
    });
  }

  function unlock(card, save) {
    const key = card.dataset.key;
    card.classList.remove('is-locked');
    card.classList.add('is-unlocked');
    card.querySelector('.t10th-lock-badge').style.display = 'none';
    card.querySelector('.t10th-open-arrow').style.display = '';
    if (save) {
      lsAdd(key);
      fetch('/api/theory/unlock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theory_key: key })
      }).catch(() => {});
    }
  }

  initZsTrainer();

  function initZsTrainer() {
    const modal = document.getElementById('t10th-zs-modal');
    const openBtn = document.getElementById('t10th-zs-open-btn');
    const closeBtn = document.getElementById('t10th-zs-close');
    const trainer = document.getElementById('t10th-zs-trainer');
    if (!trainer || !modal || !openBtn || !closeBtn) return;

    const letterNode = document.getElementById('t10th-zs-letter');
    const progressNode = document.getElementById('t10th-zs-progress');
    const feedbackNode = document.getElementById('t10th-zs-feedback');
    const nextBtn = document.getElementById('t10th-zs-next');
    const restartBtn = document.getElementById('t10th-zs-restart');
    const answerButtons = Array.from(trainer.querySelectorAll('[data-answer]'));

    const voiced = ['б', 'в', 'г', 'д', 'ж', 'з', 'л', 'м', 'н', 'р'];
    const voiceless = ['к', 'п', 'с', 'т', 'ф', 'х', 'ц', 'ч', 'ш', 'щ'];
    const roundsTotal = 8;

    let rounds = [];
    let current = 0;
    let score = 0;
    let answered = false;

    const randomItems = (arr, count) => {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy.slice(0, count);
    };

    const makeRounds = () => {
      const set = [
        ...randomItems(voiced, roundsTotal / 2).map(letter => ({ letter, type: 'voiced' })),
        ...randomItems(voiceless, roundsTotal / 2).map(letter => ({ letter, type: 'voiceless' }))
      ];
      return randomItems(set, set.length);
    };

    const typeLabel = (type) => (type === 'voiced' ? 'звонкая' : 'глухая');

    const drawRound = () => {
      const item = rounds[current];
      letterNode.textContent = item.letter;
      progressNode.textContent = `Раунд ${current + 1}/${roundsTotal}`;
      feedbackNode.textContent = 'Нажми на вариант ответа.';
      feedbackNode.classList.remove('is-ok', 'is-error');
      answered = false;
      nextBtn.style.display = 'none';
      answerButtons.forEach(btn => { btn.disabled = false; });
    };

    const finish = () => {
      letterNode.textContent = score >= roundsTotal - 1 ? '🏆' : '✓';
      progressNode.textContent = `Результат: ${score}/${roundsTotal}`;
      feedbackNode.textContent = score === roundsTotal
        ? 'Идеально! В приставках на з-/с- почти не будет ошибок.'
        : 'Серия завершена. Нажми «Новая серия», чтобы закрепить правило.';
      feedbackNode.classList.remove('is-error');
      feedbackNode.classList.add('is-ok');
      nextBtn.style.display = 'none';
      answerButtons.forEach(btn => { btn.disabled = true; });
    };

    const restart = () => {
      rounds = makeRounds();
      current = 0;
      score = 0;
      drawRound();
    };

    const openModal = () => {
      modal.style.display = 'flex';
      restart();
    };

    const closeModal = () => {
      modal.style.display = 'none';
    };

    answerButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (answered) return;
        answered = true;

        const selected = btn.dataset.answer;
        const correct = rounds[current].type;
        const isCorrect = selected === correct;

        if (isCorrect) {
          score += 1;
          feedbackNode.textContent = `Верно: "${rounds[current].letter}" — ${typeLabel(correct)} согласная.`;
          feedbackNode.classList.remove('is-error');
          feedbackNode.classList.add('is-ok');
        } else {
          feedbackNode.textContent = `Неверно: "${rounds[current].letter}" — это ${typeLabel(correct)} согласная.`;
          feedbackNode.classList.remove('is-ok');
          feedbackNode.classList.add('is-error');
        }

        answerButtons.forEach(button => { button.disabled = true; });
        nextBtn.style.display = current < roundsTotal - 1 ? 'inline-flex' : 'none';
        if (current === roundsTotal - 1) finish();
      });
    });

    nextBtn.addEventListener('click', () => {
      current += 1;
      drawRound();
    });

    restartBtn.addEventListener('click', restart);
    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.style.display !== 'none') closeModal();
    });
  }

  // Добавляем кнопку «Тренировать» в каждый блок
  document.querySelectorAll('.t10th-block[data-rule]').forEach(block => {
    const rule = block.dataset.rule;
    const body = block.querySelector('.t10th-block-body');
    if (!body) return;
    const btn = document.createElement('button');
    btn.className = 'btn btn-outline btn-sm t10th-practice-btn';
    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Тренировать';
    btn.addEventListener('click', e => {
      e.stopPropagation();
      startPractice(rule, btn);
    });
    body.appendChild(btn);
  });

  async function startPractice(rule, btn) {
    btn.disabled = true;
    btn.textContent = 'Создаём задание…';
    try {
      const r = await fetch('/api/task10/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rules: [rule], tasks_count: 1, correct_count: 3, is_practice: true })
      });
      const data = await r.json();
      if (data.id) {
        const params = new URLSearchParams({ practice: rule, step: '1', total: '5' });
        window.location.href = `/task10/${data.id}?${params}`;
      } else {
        btn.textContent = 'Нет заданий для этого правила';
        setTimeout(() => { btn.disabled = false; btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Тренировать'; }, 2000);
      }
    } catch {
      btn.disabled = false;
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Тренировать';
    }
  }

  const trainAllBtn = document.getElementById('t10th-train-all-btn');
  if (trainAllBtn) {
    trainAllBtn.addEventListener('click', async () => {
      trainAllBtn.disabled = true;
      trainAllBtn.textContent = 'Создаём задание…';
      try {
        const unlockedRules = [...document.querySelectorAll('.t10th-lockable.is-unlocked[data-rule]')]
          .map(el => el.dataset.rule);
        const rules = unlockedRules.length ? unlockedRules : null;
        const body = rules ? { rules, tasks_count: 1, correct_count: 3, is_practice: true }
                           : { tasks_count: 1, correct_count: 3, is_practice: true };
        const r = await fetch('/api/task10/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await r.json();
        if (data.id) {
          const params = new URLSearchParams({ practice: 'all', step: '1', total: '5' });
          window.location.href = `/task10/${data.id}?${params}`;
        } else {
          trainAllBtn.textContent = 'Нет доступных заданий';
          setTimeout(() => {
            trainAllBtn.disabled = false;
            trainAllBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Тренироваться';
          }, 2000);
        }
      } catch {
        trainAllBtn.disabled = false;
        trainAllBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Тренироваться';
      }
    });
  }

  const modal = document.getElementById('t10th-unlock-modal');
  let pendingCard = null;

  document.querySelectorAll('.t10th-lockable').forEach(card => {
    card.addEventListener('click', () => {
      if (card.classList.contains('is-unlocked')) return;
      pendingCard = card;
      modal.style.display = 'flex';
    });
  });

  document.getElementById('t10th-unlock-confirm').addEventListener('click', () => {
    modal.style.display = 'none';
    if (pendingCard) { unlock(pendingCard, true); pendingCard = null; }
  });
  document.getElementById('t10th-unlock-cancel').addEventListener('click', () => {
    modal.style.display = 'none';
    pendingCard = null;
  });
})();

fetch('/api/progress/theory/view', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ task_key: 'task10' }) }).catch(() => {});
</script>
