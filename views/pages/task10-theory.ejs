  background: linear-gradient(180deg, var(--brand-hover), rgba(122, 184, 226, 0.03));
  display: flex;
  flex-direction: column;
  align-items: center;
}
.t10th-zs-trainer-head {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 12px;
  align-items: center;
  margin-bottom: 6px;
}
.t10th-zs-progress { font-size: 12px; font-weight: 600; color: var(--brand); }
.t10th-zs-subtitle { margin: 6px 0 12px; font-size: 13px; color: var(--text-secondary); }
.t10th-zs-letter {
  width: 68px;
  height: 68px;
  border-radius: 14px;
  border: 1px solid var(--glass-border);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: 38px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  box-shadow: inset 0 0 0 1px var(--brand-hover);
}
.t10th-zs-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.t10th-zs-actions .btn {
  min-width: 110px;
  justify-content: center;
}
.t10th-zs-feedback {
  margin-top: 12px;
