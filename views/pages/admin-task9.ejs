<script src="/js/admin-task-shared.js"></script>
<script>
const escHtml = (s) => AdminTasks.escHtml(s);
const esc = (s) => AdminTasks.escAttr(s);

const CATEGORY_LABELS = { alternating: 'Чередующиеся', verifiable: 'Проверяемые', unverifiable: 'Непроверяемые' };

// Показ/скрытие дополнительных полей по категории
function onCategoryChange(value) {
  const showVerif = value === 'verifiable' || value === 'unverifiable';
  document.getElementById('extra-verifiable').style.display  = showVerif         ? '' : 'none';
  document.getElementById('extra-alternating').style.display = value === 'alternating' ? '' : 'none';
  document.getElementById('verif-label').textContent =
    value === 'unverifiable' ? 'Общий корень (для группировки)' : 'Проверочное слово';
  document.getElementById('word-verification').placeholder =
    value === 'unverifiable' ? 'например: вод, гор, леc' : 'гор — горе, гора';
}

// Автоподбор пары по введённой букве
const VOWEL_TO_PAIR = { 'а':'о/а', 'о':'о/а', 'е':'е/и', 'и':'и/ы', 'ы':'и/ы', 'ю':'у/ю', 'у':'у/ю', 'ё':'о/ё', 'я':'е/я' };
function autoSelectPair(letter) {
  const pair = VOWEL_TO_PAIR[letter.toLowerCase()];
  const select = document.getElementById('word-pair');
  // Подставляем только если пара не выбрана вручную или если поле пустое
  if (pair && !select.dataset.manuallyChanged) {
    select.value = pair;
  }
}
// Фиксируем ручное изменение пары
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('word-pair').addEventListener('change', function() {
    this.dataset.manuallyChanged = '1';
  });
});

let allWords = [];

const switchTab = AdminTasks.createSwitchTab({
  tabIds: ['words', 'tasks', 'generate', 'groups', 'from-text'],
  onShow: {
    tasks() { loadAllWords(); loadTasks(); },
    generate() { loadGenTasks(); },
    groups() { loadGroups(); },
    'from-text'() { if (!allWords.length) loadWords(); },
  },
});

/* ─── СЛОВАРЬ ────────────────────────────────── */

async function loadWords() {
  const res = await fetch('/api/task9/words');
  allWords = await res.json();
  filterWords();
  ftUpdateVerifDatalist();
}

function ftUpdateVerifDatalist() {
  let dl = document.getElementById('ft-verif-datalist');
  if (!dl) {
    dl = document.createElement('datalist');
    dl.id = 'ft-verif-datalist';
    document.body.appendChild(dl);
  }
  const verifs = [...new Set(allWords.map(w => w.verification_word).filter(Boolean))]
    .sort((a, b) => a.localeCompare(b, 'ru'));
  dl.innerHTML = verifs.map(v => `<option value="${escHtml(v)}">`).join('');
}

function filterWords() {
  const q    = (document.getElementById('words-search')?.value || '').toLowerCase();
  const cat  = document.getElementById('filter-category').value;
  const pair = document.getElementById('filter-pair').value;
  const list = allWords.filter(w => {
    if (q    && !w.word_display.toLowerCase().includes(q)) return false;
    if (cat  && w.category   !== cat)  return false;
    if (pair && w.vowel_pair !== pair) return false;
    return true;
  });
  renderWords(list);
}

function renderWords(words) {
  const tbody = document.getElementById('words-tbody');
  if (!words.length) {
    tbody.innerHTML = '<tr><td colspan="7" style="color:var(--text-secondary);">Слов не найдено</td></tr>';
    return;
  }
  tbody.innerHTML = words.map(w => `
    <tr>
      <td style="font-family:monospace;font-size:16px;">${w.word_display}</td>
      <td>${w.correct_vowel}</td>
