function ftLookupWord(display) {
  const norm = display.toLowerCase().trim();
  let w = allWords.find(w => w.word_display.toLowerCase() === norm);
  if (w) return w;
  // Try without trailing parenthetical hint
  const bare = norm.replace(/\s*\([^)]*\)\s*$/, '').trim();
  if (bare !== norm) w = allWords.find(w => w.word_display.toLowerCase() === bare || w.word_display.toLowerCase() === norm);
  return w || null;
}

function ftParse() {
  const text = document.getElementById('ft-input').value;
  const status = document.getElementById('ft-parse-status');
  const parsed = [];

  for (const line of text.trim().split('\n')) {
    const m = line.trim().match(/^(\d+)[).]\s*(.+)/);
    if (!m) continue;
    const rowNum = parseInt(m[1], 10);
    const words = m[2].split(',').map(w => w.trim()).filter(Boolean);
    parsed.push({ rowNum, isCorrect: false, words: words.map(d => ({ display: d, found: ftLookupWord(d) })) });
  }

  if (!parsed.length) {
    status.textContent = 'Не удалось распознать строки. Проверьте формат.';
    status.style.color = 'var(--color-error)';
    return;
  }

  // Auto-detect correct rows: all words found AND all have same correct_vowel
  for (const row of parsed) {
    const found = row.words.filter(w => w.found);
    if (found.length === row.words.length && found.length > 0) {
      const vowels = found.map(w => w.found.correct_vowel);
      row.isCorrect = vowels.every(v => v === vowels[0]);
    }
  }

  window._ftParsedRows = parsed;
  const foundCount = parsed.flatMap(r => r.words).filter(w => w.found).length;
  const total = parsed.flatMap(r => r.words).length;
  status.textContent = `Строк: ${parsed.length} · найдено в словаре: ${foundCount} из ${total}`;
  status.style.color = 'var(--text-secondary)';

  ftRenderPreview(parsed);
  document.getElementById('ft-preview').style.display = '';
}

function ftRenderPreview(parsed) {
  const container = document.getElementById('ft-rows');
  container.innerHTML = '';

  for (const row of parsed) {
    const div = document.createElement('div');
    div.className = 'ft-row' + (row.isCorrect ? ' correct-row' : '');
    div.dataset.rowNum = row.rowNum;

    const wordsHtml = row.words.map((w) => {
      if (w.found) {
        const catLabel = CATEGORY_LABELS[w.found.category] || w.found.category;
        const extra = w.found.verification_word
          ? ` · ${escHtml(w.found.verification_word)}`
          : (w.found.alternation_rule ? ` · ${escHtml(w.found.alternation_rule)}` : '');
        return `<div class="ft-word ft-word--found" data-word-id="${w.found.id}">
          <span class="ft-word-label">${escHtml(w.display)}</span>
          <span class="ft-found-info">«${escHtml(w.found.correct_vowel)}» · ${escHtml(catLabel)}${extra}</span>
        </div>`;
      }
      return `<div class="ft-word ft-word--missing">
        <span class="ft-word-label">${escHtml(w.display)}</span>
        <div class="ft-missing-form">
          <div class="ft-missing-row">
            <input type="text" maxlength="2" class="ft-letter-inp" placeholder="·"
              title="Правильная буква" oninput="ftAutoFillPair(this); ftCheckRowCorrectness(this.closest('.ft-row'))">
            <select class="ft-pair" style="flex:1;">${FT_VOWEL_PAIR_OPT}</select>
          </div>
          <select class="ft-category" onchange="ftToggleCatFields(this)">
            <option value="">— категория —</option>
            <option value="verifiable">Безударные проверяемые</option>
            <option value="alternating">Чередующиеся</option>
            <option value="unverifiable">Безударные непроверяемые</option>
          </select>
          <div class="ft-verif-wrap" style="display:none;">
            <input type="text" class="ft-verif-inp" list="ft-verif-datalist" placeholder="Проверочное слово" autocomplete="off">
          </div>
          <div class="ft-alt-wrap" style="display:none;">
            <select class="ft-alt-sel">${FT_ALT_OPT}</select>
          </div>
        </div>
      </div>`;
    }).join('');

    div.innerHTML = `
      <div class="ft-row-header">
        <span style="font-size:13px;font-weight:600;color:var(--text-secondary);min-width:60px;">Строка ${row.rowNum}</span>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:14px;font-weight:500;">
          <input type="checkbox" class="ft-correct-cb" ${row.isCorrect ? 'checked' : ''}
            onchange="this.closest('.ft-row').classList.toggle('correct-row',this.checked)">
          правильная строка
        </label>
      </div>
      <div class="ft-words">${wordsHtml}</div>`;
    container.appendChild(div);
  }
}

function ftAutoFillPair(input) {
  const letter = input.value.toLowerCase().slice(-1);
  const pair = VOWEL_TO_PAIR[letter];
  if (pair) input.closest('.ft-word').querySelector('.ft-pair').value = pair;
}

function ftCheckRowCorrectness(rowEl) {
  if (!rowEl) return;
  const letters = [];
  for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
    if (wordEl.dataset.wordId) {
      const w = allWords.find(w => w.id === +wordEl.dataset.wordId);
      if (!w) return;
      letters.push(w.correct_vowel.toLowerCase());
    } else {
      const letter = (wordEl.querySelector('.ft-letter-inp')?.value || '').trim().toLowerCase().slice(-1);
      if (!letter) return; // не все буквы заполнены — не трогаем чекбокс
      letters.push(letter);
    }
  }
  if (letters.length !== 3) return;
  const allSame = letters.every(l => l === letters[0]);
  const cb = rowEl.querySelector('.ft-correct-cb');
  if (cb) { cb.checked = allSame; rowEl.classList.toggle('correct-row', allSame); }
}

function ftToggleCatFields(sel) {
  const word = sel.closest('.ft-word');
  const showVerif = sel.value === 'verifiable' || sel.value === 'unverifiable';
  word.querySelector('.ft-verif-wrap').style.display = showVerif                  ? '' : 'none';
  word.querySelector('.ft-alt-wrap').style.display   = sel.value === 'alternating' ? '' : 'none';
  const inp = word.querySelector('.ft-verif-inp');
  if (inp) inp.placeholder = sel.value === 'unverifiable' ? 'Общий корень (для группировки)' : 'Проверочное слово';
}

async function ftCreate() {
  const btn = document.getElementById('ft-create-btn');
  const status = document.getElementById('ft-create-status');
  btn.disabled = true;
  status.style.color = 'var(--text-secondary)';
  status.textContent = '';

  try {
    const rowEls = document.querySelectorAll('#ft-rows .ft-row');
    if (rowEls.length !== 5) throw new Error(`Нужно ровно 5 строк (сейчас: ${rowEls.length})`);

    const rows = [];
    for (const rowEl of rowEls) {
      const rowNum = +rowEl.dataset.rowNum;
      const isCorrect = rowEl.querySelector('.ft-correct-cb').checked;
      const wordIds = [];

      for (const wordEl of rowEl.querySelectorAll('.ft-word')) {
        if (wordEl.dataset.wordId) {
          wordIds.push(+wordEl.dataset.wordId);
          continue;
        }
        // Missing word — collect form data
        const display = wordEl.querySelector('.ft-word-label').textContent.trim();
        const letter   = (wordEl.querySelector('.ft-letter-inp')?.value || '').trim().toLowerCase().slice(-1);
        const pair     = wordEl.querySelector('.ft-pair')?.value;
        const category = wordEl.querySelector('.ft-category')?.value;

        if (!letter)   throw new Error(`«${display}»: укажите правильную букву`);
        if (!pair)     throw new Error(`«${display}»: выберите пару букв`);
        if (!category) throw new Error(`«${display}»: выберите категорию`);

        const verifWord = category === 'verifiable'  ? (wordEl.querySelector('.ft-verif-inp')?.value.trim() || null) : null;
        const altRule   = category === 'alternating' ? (wordEl.querySelector('.ft-alt-sel')?.value || null) : null;

        status.textContent = `Добавляем «${display}» в словарь…`;
        const res = await fetch('/api/task9/words', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            word_display: display, correct_vowel: letter, vowel_pair: pair, category,
            verification_word: verifWord, alternation_rule: altRule, auto_group: true
          })
        });
        const data = await res.json();
        if (data.error) throw new Error(`«${display}»: ${data.error}`);
        wordEl.dataset.wordId = data.id; // prevent re-creation on retry
        wordIds.push(data.id);
      }

      if (wordIds.length !== 3) throw new Error(`Строка ${rowNum}: нужно 3 слова, найдено ${wordIds.length}`);
      rows.push({ row_index: rowNum, is_correct: isCorrect, word_ids: wordIds });
    }

    const correctCount = rows.filter(r => r.is_correct).length;
    if (correctCount < 2 || correctCount > 5) throw new Error('Отметьте от 2 до 5 правильных строк');

    status.textContent = 'Сохраняем задание…';
    const res = await fetch('/api/task9/tasks', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rows })
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error);

    status.style.color = '';
    status.innerHTML = `<span style="color:var(--color-success);">✓ Задание #${data.id} создано.
      <a href="/task9/${data.id}" target="_blank" style="color:inherit;text-decoration:underline;">Открыть →</a></span>`;
    document.getElementById('ft-preview').style.display = 'none';
    document.getElementById('ft-input').value = '';
    document.getElementById('ft-parse-status').textContent = '';
    await loadWords();

  } catch (err) {
    status.style.color = 'var(--color-error)';
    status.textContent = err.message;
  } finally {
    btn.disabled = false;
  }
}

loadWords();
</script>
