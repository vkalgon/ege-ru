<div class="th-page">

  <div class="th-header">
    <div class="th-header-top">
      <h2 class="th-title">Чередующиеся гласные в корне</h2>
    </div>
    <p class="th-desc">
      Написание зависит от условия, а не от ударения — проверять однокоренными словами нельзя.
      Запомните правило для каждой группы корней.
    </p>
  </div>

  <!-- ──────────────── 1. По ударению ──────────────── -->
  <section class="t9alt-section t9alt-locked-section" data-lock-key="task9-alt-stress" data-lock-name="По ударению">
    <div class="t9alt-section-header t9alt-stress">
      <span class="t9alt-section-badge">По ударению</span>
      <span class="t9alt-section-rule">Без ударения → одна буква, под ударением → другая</span>
    </div>

    <div class="t9alt-section-body">
      <div class="t9alt-rules-grid">
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">гар / <span class="t9alt-root-hl">гор</span></div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">без ударения → О</span>
              <span class="t9alt-words">заг<em>о</em>рать, г<em>о</em>реть, уг<em>о</em>реть</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">под ударением → А</span>
              <span class="t9alt-words">заг<em>а</em>р, уг<em>а</em>р, г<em>а</em>рь</span>
            </div>
            <div class="t9alt-excl">Исключения (без ударения → А): вы́гарки, и́згарь, при́гарь</div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">зар / <span class="t9alt-root-hl">зор</span></div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">без ударения → А</span>
              <span class="t9alt-words">з<em>а</em>ря, з<em>а</em>рница, оз<em>а</em>рить</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">под ударением → О или А</span>
              <span class="t9alt-words">з<em>о</em>рька, з<em>о</em>ри; з<em>а</em>рево</span>
            </div>
            <div class="t9alt-excl">Исключения: зоревать, зоревой</div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">клан / <span class="t9alt-root-hl">клон</span></div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">без ударения → О</span>
              <span class="t9alt-words">покл<em>о</em>ниться, накл<em>о</em>нить</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-ao">под ударением → А или О</span>
              <span class="t9alt-words">кл<em>а</em>няться; накл<em>о</em>н</span>
            </div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">твар / <span class="t9alt-root-hl">твор</span></div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">без ударения → О</span>
              <span class="t9alt-words">тв<em>о</em>рить, тв<em>о</em>рение, тв<em>о</em>рец</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">под ударением → А</span>
              <span class="t9alt-words">тв<em>а</em>рь</span>
            </div>
            <div class="t9alt-excl">Исключение: утварь</div>
          </div>
        </div>
      </div>

      <div class="t9alt-train-row">
        <button class="t9alt-train-btn" id="btn-train-stress" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Тренировать эти корни
        </button>
        <span class="t9alt-train-hint">гар/гор · зар/зор · клан/клон · твар/твор</span>
      </div>

      <div class="t9alt-lock-overlay">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="t9alt-lock-label">По ударению</span>
        <button class="t9alt-lock-btn" type="button">Изучить раздел</button>
      </div>
    </div>
  </section>

  <!-- ──────────────── 2. По суффиксу -А- ──────────────── -->
  <section class="t9alt-section t9alt-locked-section" data-lock-key="task9-alt-suffix" data-lock-name="По суффиксу -А-">
    <div class="t9alt-section-header t9alt-suffix">
      <span class="t9alt-section-badge">По суффиксу -А-</span>
      <span class="t9alt-section-rule">Если за корнем стоит суффикс <strong>-а-</strong> → И&thinsp;/&thinsp;им&thinsp;/&thinsp;ин; без него → Е&thinsp;/&thinsp;ем&thinsp;/&thinsp;ен</span>
    </div>

    <div class="t9alt-section-body">
      <div class="th-table-wrap">
        <table class="th-table t9alt-table">
          <thead>
            <tr><th>Корень</th><th>С суффиксом -А- → И</th><th>Без суффикса -А- → Е</th></tr>
          </thead>
          <tbody>
            <tr><td>бир / бер</td><td>соб<em>и</em>рать</td><td>соб<em>е</em>рёт</td></tr>
            <tr><td>блист / блест</td><td>бл<em>и</em>стать</td><td>бл<em>е</em>стеть</td></tr>
            <tr><td>дир / дер</td><td>зад<em>и</em>рать</td><td>зад<em>е</em>рёт</td></tr>
            <tr><td>жиг / жег</td><td>сж<em>и</em>гать</td><td>сж<em>е</em>чь</td></tr>
            <tr><td>стил / стел</td><td>расст<em>и</em>лать</td><td>расст<em>е</em>лить</td></tr>
            <tr><td>тир / тер</td><td>ст<em>и</em>рать</td><td>ст<em>е</em>реть</td></tr>
            <tr><td>пир / пер</td><td>зап<em>и</em>рать</td><td>зап<em>е</em>реть</td></tr>
            <tr><td>мир / мер</td><td>ум<em>и</em>рать</td><td>ум<em>е</em>реть</td></tr>
            <tr><td>чит / чет</td><td>сч<em>и</em>тать</td><td>сч<em>е</em>т, почт<em>е</em>нный</td></tr>
            <tr><td>им / ин (ем / ен)</td><td>сн<em>им</em>ать, ж<em>ин</em>ать</td><td>сн<em>ем</em>у, ж<em>ен</em>ьшень</td></tr>
          </tbody>
        </table>
      </div>

      <div class="t9alt-train-row">
        <button class="t9alt-train-btn" id="btn-train-suffix" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Тренировать эти корни
        </button>
        <span class="t9alt-train-hint">бир/бер · дир/дер · тир/тер · пир/пер · мир/мер · жиг/жег · стил/стел · блист/блест · чит/чет · им/ин</span>
      </div>

      <div class="t9alt-lock-overlay">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="t9alt-lock-label">По суффиксу -А-</span>
        <button class="t9alt-lock-btn" type="button">Изучить раздел</button>
      </div>
    </div>
  </section>

  <!-- ──────────────── 3. По следующей букве ──────────────── -->
  <section class="t9alt-section t9alt-locked-section" data-lock-key="task9-alt-consonant" data-lock-name="По следующей букве">
    <div class="t9alt-section-header t9alt-consonant">
      <span class="t9alt-section-badge">По следующей букве</span>
      <span class="t9alt-section-rule">Гласная зависит от согласной, которая идёт после корня</span>
    </div>

    <div class="t9alt-section-body">
      <div class="t9alt-rules-grid">
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">кас / кос</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">перед -А- → А</span>
              <span class="t9alt-words">к<em>а</em>саться, к<em>а</em>сание</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">иначе → О</span>
              <span class="t9alt-words">к<em>о</em>снуться, прик<em>о</em>снуться</span>
            </div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">лаг / лож</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">перед Г → А</span>
              <span class="t9alt-words">пол<em>а</em>гать, изл<em>а</em>гать, прил<em>а</em>гать</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">перед Ж → О</span>
              <span class="t9alt-words">пол<em>о</em>жить, изл<em>о</em>жение, прил<em>о</em>жить</span>
            </div>
            <div class="t9alt-excl">Исключение: полог</div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">раст / рос</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">перед СТ и Щ → А</span>
              <span class="t9alt-words">р<em>а</em>стение, р<em>а</em>сти, р<em>а</em>щу</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">иначе → О</span>
              <span class="t9alt-words">р<em>о</em>сли, р<em>о</em>сток, выр<em>о</em>сший</span>
            </div>
            <div class="t9alt-excl">Исключения: росток, Ростов, Ростислав, отрасль</div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">скак / скоч</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">перед К → А</span>
              <span class="t9alt-words">ск<em>а</em>кать, поск<em>а</em>кать</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">перед Ч → О</span>
              <span class="t9alt-words">ск<em>о</em>чить, выск<em>о</em>чить</span>
            </div>
            <div class="t9alt-excl">Исключения: скачок, скачу</div>
          </div>
        </div>
      </div>

      <div class="t9alt-train-row">
        <button class="t9alt-train-btn" id="btn-train-consonant" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Тренировать эти корни
        </button>
        <span class="t9alt-train-hint">кас/кос · лаг/лож · раст/рос · скак/скоч</span>
      </div>

      <div class="t9alt-lock-overlay">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="t9alt-lock-label">По следующей букве</span>
        <button class="t9alt-lock-btn" type="button">Изучить раздел</button>
      </div>
    </div>
  </section>

  <!-- ──────────────── 4. По значению ──────────────── -->
  <section class="t9alt-section t9alt-locked-section" data-lock-key="task9-alt-meaning" data-lock-name="По значению">
    <div class="t9alt-section-header t9alt-meaning">
      <span class="t9alt-section-badge">По значению</span>
      <span class="t9alt-section-rule">Гласная зависит от смысла слова</span>
    </div>

    <div class="t9alt-section-body">
      <div class="t9alt-rules-grid">
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">мак / мок</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">«окунать, погружать» → А</span>
              <span class="t9alt-words">м<em>а</em>кать хлеб в молоко</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">«намокнуть, впитывать» → О</span>
              <span class="t9alt-words">м<em>о</em>крый, пром<em>о</em>кнуть, м<em>о</em>кнуть под дождём</span>
            </div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">равн / ровн</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">«одинаковый, сравнивать» → А</span>
              <span class="t9alt-words">р<em>а</em>вный, ур<em>а</em>внение, ср<em>а</em>внить</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">«прямой, гладкий, ровный» → О</span>
              <span class="t9alt-words">р<em>о</em>вный, пор<em>о</em>внять дорогу</span>
            </div>
            <div class="t9alt-excl">Исключения: равнина, поровну, ровесник</div>
          </div>
        </div>
        <div class="t9alt-rule-card">
          <div class="t9alt-rule-root">плав / плов / плыв</div>
          <div class="t9alt-rule-body">
            <div class="t9alt-rule-line"><span class="t9alt-badge-a">почти всегда → А</span>
              <span class="t9alt-words">пл<em>а</em>вать, пл<em>а</em>вник, пл<em>а</em>вучий</span>
            </div>
            <div class="t9alt-rule-line"><span class="t9alt-badge-o">исключения с О и Ы</span>
              <span class="t9alt-words">пл<em>о</em>вец, пл<em>о</em>вчиха; пл<em>ы</em>вун</span>
            </div>
          </div>
        </div>
      </div>

      <div class="t9alt-train-row">
        <button class="t9alt-train-btn" id="btn-train-meaning" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Тренировать эти корни
        </button>
        <span class="t9alt-train-hint">мак/мок · равн/ровн · плав/плов/плыв</span>
      </div>

      <div class="t9alt-lock-overlay">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="t9alt-lock-label">По значению</span>
        <button class="t9alt-lock-btn" type="button">Изучить раздел</button>
      </div>
    </div>
  </section>

</div>

<style>
/* ── Секции ── */
.t9alt-section { margin-bottom: 36px; }

.t9alt-section-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.t9alt-section-badge {
  font-size: 13px;
  font-weight: 600;
  border-radius: 20px;
  padding: 4px 14px;
  white-space: nowrap;
  background: var(--brand-muted);
  color: var(--brand);
}
.t9alt-section-rule {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
}
.t9alt-section-rule strong { color: var(--text-primary); }

/* ── Сетка карточек ── */
.t9alt-rules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 12px;
}

.t9alt-rule-card {
  background: var(--bg-secondary);
  border: 1px solid var(--glass-border);
  border-radius: 10px;
  padding: 14px 16px;
}
.t9alt-rule-root {
  font-size: 16px;
  font-weight: 700;
  color: var(--brand);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}
.t9alt-root-hl {
  background: rgba(96, 165, 250, 0.18);
  color: #2563eb;
  border-radius: 5px;
  padding: 1px 6px;
  font-weight: 800;
}
.t9alt-rule-body { display: flex; flex-direction: column; gap: 7px; }
.t9alt-rule-line {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Значки гласных */
.t9alt-badge-a,
.t9alt-badge-o,
.t9alt-badge-ao {
  font-size: 11px;
  font-weight: 600;
  border-radius: 5px;
  padding: 2px 7px;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 1px;
}
.t9alt-badge-a  { background: rgba(251, 191, 36, 0.18); color: #b45309; }
.t9alt-badge-o  { background: rgba(96, 165, 250, 0.18); color: #2563eb; }
.t9alt-badge-ao { background: rgba(156, 163, 175, 0.15); color: var(--text-secondary); }

.t9alt-words {
  font-size: 13px;
  color: var(--text-primary);
  line-height: 1.55;
}
.t9alt-words em {
  font-style: normal;
  font-weight: 700;
  color: var(--brand);
}
.t9alt-excl {
  font-size: 12px;
  color: var(--text-secondary);
  font-style: italic;
  margin-top: 2px;
}

/* ── Таблица суффикса -А- (дополняет .th-table) ── */
.t9alt-table em {
  font-style: normal;
  font-weight: 700;
  color: var(--brand);
}
.t9alt-table td:first-child {
  font-weight: 600;
  color: var(--brand);
  white-space: nowrap;
}

/* ── Кнопка тренировки ── */
.t9alt-train-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 4px 0 36px;
  flex-wrap: wrap;
}

.t9alt-train-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: var(--brand-muted);
  border: 1px solid var(--brand-ripple);
  border-radius: 50px;
  color: var(--brand);
  font: 600 14px/18px "Inter", sans-serif;
  cursor: pointer;
  transition: background 0.18s, border-color 0.18s, transform 0.12s;
  white-space: nowrap;
}
.t9alt-train-btn:hover {
  background: var(--brand-medium);
  border-color: var(--brand);
  transform: translateY(-1px);
}
.t9alt-train-btn:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}

.t9alt-train-hint {
  font-size: 12px;
  color: var(--text-secondary);
}

/* ── Замок на секции ── */
.t9alt-section-body { position: relative; }

.t9alt-lock-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  border-radius: 12px;
  background: var(--glass-bg);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--glass-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 24px;
  min-height: 120px;
  color: var(--text-secondary);
  transition: opacity 0.25s;
}
.t9alt-lock-overlay svg { opacity: 0.55; flex-shrink: 0; }

.t9alt-lock-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.t9alt-lock-btn {
  margin-top: 4px;
  padding: 8px 22px;
  border-radius: 50px;
  border: 1px solid var(--brand-ripple);
  background: var(--brand-muted);
  color: var(--brand);
  font: 600 13px/18px "Inter", sans-serif;
  cursor: pointer;
  transition: background 0.18s, border-color 0.18s;
}
.t9alt-lock-btn:hover {
  background: var(--brand-medium);
  border-color: var(--brand);
}

.t9alt-locked-section.is-unlocked .t9alt-lock-overlay { display: none; }
</style>

<script>
(function initSectionLocks() {
  const LS_KEY = 'theory_unlocked';

  function lsGet() {
    try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; }
  }
  function lsAdd(key) {
    const arr = lsGet();
    if (!arr.includes(key)) { arr.push(key); localStorage.setItem(LS_KEY, JSON.stringify(arr)); }
  }

  let unlocked = [...lsGet()];

  function applyStates() {
    document.querySelectorAll('.t9alt-locked-section').forEach(section => {
      const key = section.dataset.lockKey;
      if (unlocked.includes(key)) section.classList.add('is-unlocked');
      else section.classList.remove('is-unlocked');
    });
  }

  applyStates();

  fetch('/api/theory/unlocks').then(r => r.ok ? r.json() : {}).then(d => {
    (d.unlocked || []).forEach(k => { if (!unlocked.includes(k)) unlocked.push(k); });
    applyStates();
  }).catch(() => {});

  function unlockSection(section, key) {
    section.classList.add('is-unlocked');
    lsAdd(key);
    fetch('/api/theory/unlock', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ theory_key: key })
    }).catch(() => {});
  }

  document.querySelectorAll('.t9alt-locked-section').forEach(section => {
    const key = section.dataset.lockKey;
    section.querySelector('.t9alt-lock-btn')?.addEventListener('click', () => {
      unlockSection(section, key);
    });
  });
})();

function makeTrainHandler(btnId, rules) {
  const SVG_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
  document.getElementById(btnId).addEventListener('click', async function () {
    this.disabled = true;
    this.textContent = 'Генерируем...';
    try {
      const res = await fetch('/api/task9/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ alternation_rules: rules, categories: ['alternating'], tasks_count: 5 })
      });
      const data = await res.json();
      if (data.error) { alert(data.error); return; }
      location.href = '/task9/' + data.id;
    } catch (e) {
      alert('Ошибка генерации');
    } finally {
      this.disabled = false;
      this.innerHTML = SVG_ICON + ' Тренировать эти корни';
    }
  });
}

makeTrainHandler('btn-train-stress',   ['гар/гор', 'зар/зор', 'клан/клон', 'твар/твор']);
makeTrainHandler('btn-train-suffix',   ['бир/бер', 'дир/дер', 'тир/тер', 'пир/пер', 'мир/мер', 'жиг/жег', 'стил/стел', 'блист/блест', 'чит/чет', 'им/ин']);
makeTrainHandler('btn-train-consonant',['кас/кос', 'лаг/лож', 'раст/рос', 'скак/скоч']);
makeTrainHandler('btn-train-meaning',  ['мак/мок', 'равн/ровн', 'плав/плов/плыв']);
</script>
