/* ─── Модальное окно: слова по заданию ────────────────────── */
let _weakWordsCache = null;
let _masteryThresholdCache = 5;

async function getWeakWordsData() {
  if (_weakWordsCache) return _weakWordsCache;
  const r = await fetch('/api/progress/weak-words');
  const data = await r.json();
  _weakWordsCache = data.weak_words || [];
  _masteryThresholdCache = data.mastery_threshold || 5;
  return _weakWordsCache;
}

async function openWordsModal(taskKey, taskLabel) {
  const overlay = document.getElementById('words-modal-overlay');
  const body = document.getElementById('words-modal-body');
  document.getElementById('words-modal-title').textContent = taskLabel + ' — статистика';
  body.innerHTML = '<div class="skeleton-loader">Загрузка...</div>';
  overlay.style.display = 'flex';
  document.body.style.overflow = 'hidden';

  if (taskKey === 'task9') {
    const [statsRes, weakWords] = await Promise.all([
      fetch('/api/progress/task9-stats'),
      getWeakWordsData(),
    ]);
    const stats = statsRes.ok ? await statsRes.json() : { categories: [], roots: [] };
    const group = weakWords.find(g => g.word_table === 'task9_words');
    renderTask9StatsModal(body, stats, group?.words || []);
    return;
  }

  const wordTable = taskKey + '_words';
  const weakWords = await getWeakWordsData();
  const group = weakWords.find(g => g.word_table === wordTable);
  document.getElementById('words-modal-title').textContent = taskLabel + ' — слова для повторения';
  renderWordsModalBody(body, group?.words || [], wordTable);
}

const CAT_LABELS = {
  alternating:  'Чередующиеся',
  verifiable:   'Проверяемые',
  unverifiable: 'Непроверяемые',
};

function renderTask9StatsModal(body, stats, weakWords) {
  const { categories, roots } = stats;

  if (!categories.length) {
    body.innerHTML = '<p class="empty-state">Вы ещё не решали задание 9. Начните практику!</p>';
    return;
  }

  const sorted = [...categories].sort((a, b) => b.errors - a.errors);

  const catHtml = sorted.map(c => {
    const label = CAT_LABELS[c.category] || c.category;
    const color = c.accuracy >= 70 ? 'var(--color-success)' : c.accuracy >= 50 ? 'var(--color-warning)' : 'var(--color-error)';
    return `
      <div class="t9s-cat-row">
        <div class="t9s-cat-top">
          <span class="t9s-cat-name">${label}</span>
          <span class="t9s-cat-nums">
            <span style="color:${color};font-weight:600">${c.accuracy}%</span>
            <span class="t9s-dim">· ${c.errors} ${pluralErrors(c.errors)} из ${c.attempts}</span>
          </span>
        </div>
        <div class="accuracy-bar">
          <div class="accuracy-fill" style="width:${c.accuracy}%;background:${color}"></div>
        </div>
      </div>`;
  }).join('');

  const rootsHtml = roots.length ? `
    <div class="t9s-section-title">Проблемные корни (чередующиеся)</div>
    <div class="t9s-roots-list">
      ${roots.map(r => {
        const color = r.accuracy >= 70 ? 'var(--color-success)' : r.accuracy >= 50 ? 'var(--color-warning)' : 'var(--color-error)';
        return `
          <div class="t9s-root-row">
            <span class="t9s-root-name">${r.rule}</span>
            <span class="t9s-root-right">
              <span style="color:${color};font-weight:600">${r.accuracy}%</span>
              <span class="t9s-dim">${r.errors} ${pluralErrors(r.errors)}</span>
            </span>
          </div>`;
      }).join('')}
    </div>` : '';

  const wordsSection = weakWords.length ? `
    <div class="t9s-words-toggle-row">
      <button class="btn btn-sm btn-outline" id="t9s-toggle-words-btn" onclick="toggleTask9Words(this)">
        Смотреть все слова с ошибками (${weakWords.length})
      </button>
    </div>
    <div id="t9s-words-list" style="display:none"></div>` : '';

  body.innerHTML = `
    <div class="t9s-section-title">Точность по типам</div>
    ${catHtml}
    ${rootsHtml}
    ${wordsSection}
  `;

  if (weakWords.length) {
    body._weakWords = weakWords;
  }
}

function toggleTask9Words(btn) {
  const list = document.getElementById('t9s-words-list');
  const body = document.getElementById('words-modal-body');
  if (list.style.display === 'none') {
    list.style.display = 'block';
    renderWordsModalBody(list, body._weakWords || [], 'task9_words');
    btn.textContent = 'Скрыть слова';
  } else {
    list.style.display = 'none';
    btn.textContent = `Смотреть все слова с ошибками (${(body._weakWords || []).length})`;
  }
}

function renderWordsModalBody(body, words, wordTable) {
  if (!words.length) {
    body.innerHTML = '<p class="empty-state">Слов для повторения нет — отличная работа!</p>';
    return;
  }

  body.innerHTML = words.map(w => `
    <div class="wm-word-item" id="wm-word-${wordTable}-${w.word_id}">
      <div class="wm-word-top">
        <span class="wm-word-text">${w.word}</span>
        <span class="weak-word-errors">${w.errors} ${pluralErrors(w.errors)}</span>
      </div>
      <div class="weak-word-rule">${w.rule}</div>
      <div class="mastery-bar-wrap">
        <div class="mastery-bar"><div class="mastery-fill" style="width:${w.mastery}%"></div></div>
        <span class="mastery-label">${w.streak}/${_masteryThresholdCache} подряд</span>
      </div>
      <div class="wm-word-actions">
        <button class="btn btn-sm btn-outline" onclick="masterWord('${wordTable}', ${w.word_id})">Отметить запомненным</button>
        <button class="btn btn-sm btn-ghost wm-delete-btn" onclick="deleteWord('${wordTable}', ${w.word_id})">Удалить</button>
      </div>
    </div>
  `).join('');
}

async function deleteWord(wordTable, wordId) {
  const r = await fetch(`/api/progress/words/${wordTable}/${wordId}`, { method: 'DELETE' });
  if (!r.ok) return;
  _weakWordsCache = null;
  document.getElementById(`wm-word-${wordTable}-${wordId}`)?.remove();
  _afterWordAction(wordTable);
  loadStudentData();
}

async function masterWord(wordTable, wordId) {
  const r = await fetch(`/api/progress/words/${wordTable}/${wordId}/master`, { method: 'POST' });
  if (!r.ok) return;
  _weakWordsCache = null;
  document.getElementById(`wm-word-${wordTable}-${wordId}`)?.remove();
  _afterWordAction(wordTable);
  loadStudentData();
}

function _afterWordAction(wordTable) {
  const list = document.getElementById('t9s-words-list');
  if (list) {
    // inside task9 stats modal
    const remaining = list.querySelectorAll('.wm-word-item').length;
    const toggleBtn = document.getElementById('t9s-toggle-words-btn');
    if (remaining === 0) {
      list.innerHTML = '<p class="empty-state" style="margin:0">Слов для повторения нет — отличная работа!</p>';
      if (toggleBtn) toggleBtn.textContent = 'Слов с ошибками нет';
    } else if (toggleBtn && list.style.display !== 'none') {
      toggleBtn.textContent = `Скрыть слова`;
    }
    return;
  }
  const body = document.getElementById('words-modal-body');
  if (body && !body.querySelector('.wm-word-item')) {
    body.innerHTML = '<p class="empty-state">Слов для повторения нет — отличная работа!</p>';
  }
}

function closeWordsModal(e) {
  if (e && e.target !== document.getElementById('words-modal-overlay')) return;
  document.getElementById('words-modal-overlay').style.display = 'none';
  document.body.style.overflow = '';
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeWordsModal();
});
