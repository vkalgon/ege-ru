let currentUser = null;
let teacherStudents = [];

(async function init() {
  try {
    const r = await fetch('/api/auth/me');
    if (!r.ok) { window.location.href = '/login'; return; }
    currentUser = (await r.json()).user;
  } catch { window.location.href = '/login'; return; }

  const name = currentUser.first_name
    ? currentUser.first_name + (currentUser.last_name ? ' ' + currentUser.last_name : '')
    : (currentUser.username || currentUser.login || 'Пользователь');
  document.getElementById('profile-name').textContent = name;
  document.getElementById('edit-name-btn').style.display = '';
  renderProfileAvatar(currentUser);
  bindAvatarControls();
  bindNameEditControls();
  initHomeworkDeadlineInputs();

  const isStudent = (currentUser.role || 'student') === 'student';
  const badge = document.getElementById('profile-role-badge');
  const svgCap = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" style="vertical-align:-2px" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"/></svg>';
  const svgBook = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="14" height="14" style="vertical-align:-2px" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>';
  badge.innerHTML = isStudent ? `${svgCap} Ученик` : `${svgBook} Учитель`;
  badge.className = 'profile-role-badge ' + (isStudent ? 'badge-student' : 'badge-teacher');

  if (isStudent) {
    document.getElementById('student-section').style.display = '';
    await refreshStudentTeacherSection();
    loadStudentData();
    loadHomeworkStudent();
    loadConnectionRequests();
  } else {
    document.getElementById('teacher-section').style.display = '';
    initTeacherTabs();
    loadStudentsList();
    initTeacherBuilderGrid();
    loadInviteCode();
    loadHomeworkTeacher();
  }
})();

function renderProfileAvatar(user) {
  const name = user?.first_name || user?.username || user?.login || 'П';
  const avatar = user?.avatar || null;
  const imgEl = document.getElementById('profile-avatar-img');
  const fbEl = document.getElementById('profile-avatar-fallback');

  if (avatar && (avatar.startsWith('data:image/') || avatar.startsWith('/images/'))) {
    imgEl.src = avatar;
    imgEl.style.display = 'block';
    fbEl.style.display = 'none';
    fbEl.textContent = '';
  } else {
    imgEl.removeAttribute('src');
    imgEl.style.display = 'none';
    fbEl.style.display = 'flex';
    fbEl.textContent = avatar?.startsWith('emoji:') ? avatar.slice(6) : name.charAt(0).toUpperCase();
  }
}

function renderHeaderAvatar(user) {
  const name = user?.first_name || user?.username || user?.login || 'П';
  const avatar = user?.avatar || null;
  const avatarSpan = document.getElementById('user-avatar');
  const avatarImg = document.getElementById('user-avatar-img');
  if (!avatarSpan || !avatarImg) return;

  if (avatar && (avatar.startsWith('data:image/') || avatar.startsWith('/images/'))) {
    avatarImg.src = avatar;
    avatarImg.style.display = 'block';
    avatarSpan.style.display = 'none';
  } else {
    avatarImg.removeAttribute('src');
    avatarImg.style.display = 'none';
    avatarSpan.style.display = 'flex';
    avatarSpan.textContent = avatar?.startsWith('emoji:') ? avatar.slice(6) : name.charAt(0).toUpperCase();
  }
}

async function saveAvatarValue(avatarValue) {
  const msg = document.getElementById('avatar-msg');
  msg.textContent = '';
  msg.className = 'join-msg';

  const r = await fetch('/api/auth/avatar', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ avatar: avatarValue || null }),
  });
  const data = await r.json();
  if (!r.ok) throw new Error(data.error || 'Не удалось сохранить аватар');

  currentUser.avatar = data.avatar || null;
  renderProfileAvatar(currentUser);
  renderHeaderAvatar(currentUser);
  msg.textContent = 'Аватар обновлён';
  msg.className = 'join-msg join-msg-success';
}

function bindNameEditControls() {
  const editBtn = document.getElementById('edit-name-btn');
  const cancelBtn = document.getElementById('cancel-name-btn');
  const saveBtn = document.getElementById('save-name-btn');
  const nameEl = document.getElementById('profile-name');
  const nameRow = document.getElementById('profile-name-edit');
  const input = document.getElementById('profile-name-input');

  editBtn.addEventListener('click', () => {
    input.value = nameEl.textContent;
    nameEl.style.display = 'none';
    editBtn.style.display = 'none';
    nameRow.style.display = 'flex';
    input.focus();
    input.select();
  });

  cancelBtn.addEventListener('click', () => {
    nameRow.style.display = 'none';
    nameEl.style.display = '';
    editBtn.style.display = '';
  });

  saveBtn.addEventListener('click', async () => {
    const newName = input.value.trim();
    if (!newName) return;
    saveBtn.disabled = true;
    const r = await fetch('/api/auth/name', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: newName })
    });
    saveBtn.disabled = false;
    if (r.ok) {
      nameEl.textContent = newName;
      nameRow.style.display = 'none';
      nameEl.style.display = '';
      editBtn.style.display = '';
    }
  });

  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') saveBtn.click();
    if (e.key === 'Escape') cancelBtn.click();
  });
}

function bindAvatarControls() {
  if (window._avatarControlsBound) return;
  window._avatarControlsBound = true;

  let _cropImage = null;

  const modal      = document.getElementById('avatar-crop-modal');
  const preview    = document.getElementById('avatar-crop-preview');
  const zoomSlider = document.getElementById('avatar-zoom');
  const confirmBtn = document.getElementById('avatar-confirm-btn');
  const cancelBtn  = document.getElementById('avatar-cancel-btn');

  function openCropModal(dataUrl) {
    _cropImage = new Image();
    _cropImage.src = dataUrl;
    preview.style.transform = 'scale(1)';
    zoomSlider.value = '1';
    preview.src = dataUrl;
    modal.style.display = 'flex';
  }

  zoomSlider.addEventListener('input', () => {
    preview.style.transform = `scale(${zoomSlider.value})`;
  });

  cancelBtn.addEventListener('click', () => {
    modal.style.display = 'none';
    document.getElementById('avatar-upload-input').value = '';
  });

  confirmBtn.addEventListener('click', async () => {
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Сохраняем...';
    try {
      const SIZE = 200;
      const canvas = document.createElement('canvas');
      canvas.width = SIZE; canvas.height = SIZE;
      const ctx = canvas.getContext('2d');

      // круговая маска
      ctx.beginPath();
      ctx.arc(SIZE / 2, SIZE / 2, SIZE / 2, 0, Math.PI * 2);
      ctx.clip();

      const zoom = parseFloat(zoomSlider.value);
      const img = _cropImage;
      const side = Math.min(img.naturalWidth, img.naturalHeight);
      const sx = (img.naturalWidth - side) / 2;
      const sy = (img.naturalHeight - side) / 2;
      const scaledSide = side / zoom;
      const offset = (side - scaledSide) / 2;
      ctx.drawImage(img, sx + offset, sy + offset, scaledSide, scaledSide, 0, 0, SIZE, SIZE);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      await saveAvatarValue(dataUrl);
      modal.style.display = 'none';
    } catch (err) {
      alert(err.message || 'Ошибка сохранения');
    } finally {
      confirmBtn.disabled = false;
      confirmBtn.textContent = 'Сохранить';
      document.getElementById('avatar-upload-input').value = '';
    }
  });

  document.getElementById('avatar-upload-input')?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => openCropModal(String(reader.result || ''));
    reader.readAsDataURL(file);
  });
}

function initHomeworkDeadlineInputs() {
  // Блокируем выбор прошедших даты/времени в календаре дедлайна.
  const now = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  const localIsoMinute = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
  const inputs = ['hw-due-input', 'builder-hw-due-input'];
  inputs.forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.min = localIsoMinute;
  });
}

async function refreshStudentTeacherSection() {
  const joinSection = document.getElementById('join-teacher-section');
  const myTeacherSection = document.getElementById('my-teacher-section');
  const homeworkSection = document.getElementById('student-homework-section');
  const teacherNameEl = document.getElementById('my-teacher-name');
  const teacherLoginEl = document.getElementById('my-teacher-login');

  const r = await fetch('/api/student/teacher');
  const data = await r.json();
  const teacher = data?.teacher || null;

  if (!teacher) {
    if (joinSection) joinSection.style.display = '';
    if (myTeacherSection) myTeacherSection.style.display = 'none';
    if (homeworkSection) homeworkSection.style.display = 'none';
    return;
  }

  if (joinSection) joinSection.style.display = 'none';
  if (myTeacherSection) myTeacherSection.style.display = '';
  if (homeworkSection) homeworkSection.style.display = '';
  if (teacherNameEl) teacherNameEl.textContent = teacher.name || teacher.login || 'Учитель';
  if (teacherLoginEl) teacherLoginEl.textContent = teacher.login ? `@${teacher.login}` : '';
}

/* ─── Выход ────────────────────────────────────────────────── */
document.getElementById('logout-btn').addEventListener('click', async () => {
  await fetch('/api/auth/logout', { method: 'POST' });
  window.location.href = '/login';
});

/* ─── УЧЕНИК: данные ───────────────────────────────────────── */
async function loadStudentData() {
  const [sr, wr, tr] = await Promise.all([
    fetch('/api/progress/summary'),
    fetch('/api/progress/weak-words'),
    fetch('/api/progress/theory'),
  ]);
  const { summary } = await sr.json();
  const { weak_words } = await wr.json();
  const { theory } = await tr.json();
  renderSummary(summary);
  updateWeakPracticeBtn(weak_words);
  renderTheoryProgress(theory, summary);
}

function updateWeakPracticeBtn(weakWords) {
  const btn = document.getElementById('weak-practice-btn');
  const hint = document.getElementById('weak-practice-hint');
  const practiceSupportedTables = new Set([
    'task9_words',
    'task10_words',
    'task11_words',
    'task12_words',
  ]);
  const practiceCandidates = (weakWords || [])
    .filter(g => practiceSupportedTables.has(g.word_table) && g.words.length > 0)
    .sort((a, b) => b.words.length - a.words.length);
  const hasWeak = practiceCandidates.length > 0;

  if (hasWeak) {
    const topWeakGroup = practiceCandidates[0];
    const taskType = topWeakGroup.word_table.replace('_words', '');
    const taskLabel = (topWeakGroup.label || '').replace(/^Задание \d+ — /, '');

    btn.disabled = false;
    btn.title = '';
    hint.textContent = taskLabel
      ? `Персональная тренировка: ${taskLabel.toLowerCase()}`
      : 'Персональная тренировка по вашим ошибкам';
    btn.onclick = () => {
      window.location.href = `/practice?task=${taskType}`;
    };
  } else {
    btn.disabled = true;
    btn.title = 'Решите ещё заданий, чтобы разблокировать';
    hint.textContent = 'Решите ещё заданий 9–12, чтобы разблокировать';
    btn.onclick = null;
  }
}

function renderTheoryProgress(theory, summary) {
  const grid = document.getElementById('theory-progress-grid');
  if (!grid) return;
  if (!theory?.length) {
    grid.innerHTML = '<p class="empty-state">Пока нет данных по теории. Начните с раздела «Теория».</p>';
    return;
  }

  const summaryByTask = new Map(
    (summary || []).map(s => [String(s.word_table || '').replace('_words', ''), s])
  );

  const prepared = theory.map(t => {
    const stats = summaryByTask.get(t.task_key) || null;
    const weakCount = Number(stats?.weak_count || 0);
    const accuracy = Number(stats?.accuracy ?? 100);
    const needsTheoryRepeat = t.viewed && weakCount > 0;
    const priority = !t.viewed ? 0 : (needsTheoryRepeat ? 1 : 2);
    return { ...t, weakCount, accuracy, needsTheoryRepeat, priority };
  }).sort((a, b) => {
    if (a.priority !== b.priority) return a.priority - b.priority;
    if (a.priority === 0) return a.label.localeCompare(b.label, 'ru');
    if (a.priority === 1) {
      if (b.weakCount !== a.weakCount) return b.weakCount - a.weakCount;
      return a.accuracy - b.accuracy;
    }
    return a.label.localeCompare(b.label, 'ru');
  });

  const renderCard = (t) => {
    const viewedBadge = t.viewed
      ? `<span class="theory-badge theory-badge--done">
           <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
           Изучено
         </span>`
      : `<span class="theory-badge theory-badge--lock">
           <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
           Не изучено
         </span>`;

    const practicedBadge = t.practiced
      ? `<span class="theory-badge theory-badge--practiced">
           <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
           Практиковал
         </span>`
      : `<span class="theory-badge theory-badge--no-practice">Не практиковал</span>`;
    const repeatBadge = t.needsTheoryRepeat
      ? `<span class="theory-badge theory-badge--repeat">
           Повторить: ${t.weakCount} ${pluralWords(t.weakCount)}
         </span>`
      : '';

    const cta = t.viewed
      ? `<a href="${t.practice_url}" class="btn btn-outline btn-sm">Практиковать</a>`
      : `<a href="${t.theory_url}" class="btn btn-primary btn-sm">Изучить теорию</a>`;

    const hasBlocks = t.blocks && t.blocks.length > 0;
    const unlockedCount = hasBlocks ? t.blocks.filter(b => b.unlocked).length : 0;

    const blocksHtml = hasBlocks ? `
      <div class="theory-blocks-panel" style="display:none;">
        <div class="theory-blocks-list">
          ${t.blocks.map(b => `
            <div class="theory-block-row">
              ${b.unlocked
                ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`
                : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
              }
              <span class="${b.unlocked ? '' : 'theory-block-row--locked'}">${b.label}</span>
            </div>`).join('')}
        </div>
      </div>` : '';

    const detailsBtn = hasBlocks ? `
      <button class="btn btn-ghost btn-sm theory-details-btn" data-task="${t.task_key}">
        Подробнее <span class="theory-details-count">${unlockedCount}/${t.blocks.length}</span>
        <svg class="theory-details-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>` : '';

    return `<div class="theory-progress-card${t.viewed ? '' : ' theory-progress-card--locked'}">
      <div class="theory-progress-card__header">
        ${t.viewed ? '' : `<svg class="theory-lock-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`}
        <strong class="theory-progress-card__title">${t.label}</strong>
      </div>
      <div class="theory-progress-card__badges">${viewedBadge}${practicedBadge}${repeatBadge}</div>
      <div class="theory-progress-card__actions">
        ${cta}
        ${detailsBtn}
      </div>
      ${blocksHtml}
    </div>`;
  };

  const unseen = prepared.filter(t => !t.viewed);
  const repeat = prepared.filter(t => t.needsTheoryRepeat);
  const done = prepared.filter(t => t.viewed && !t.needsTheoryRepeat);

  const statusListHtml = `<div class="theory-status-list">
    ${prepared.map(t => {
      const taskNum = String(t.task_key || '').replace('task', '');
      const statusClass = !t.viewed ? 'theory-status-tag--new' : (t.needsTheoryRepeat ? 'theory-status-tag--repeat' : 'theory-status-tag--done');
      const statusText = !t.viewed ? 'Не изучено' : (t.needsTheoryRepeat ? `Повторить (${t.weakCount})` : 'Изучено');
      return `<div class="theory-status-item">
        <span class="theory-status-name">Задание №${taskNum}</span>
        <span class="theory-status-tag ${statusClass}">${statusText}</span>
      </div>`;
    }).join('')}
  </div>`;

  const section = (title, items, emptyText) => `
    <div class="theory-group">
      <div class="theory-group-title">${title}</div>
      ${items.length ? items.map(renderCard).join('') : `<p class="empty-state" style="margin:0">${emptyText}</p>`}
    </div>
  `;

  grid.innerHTML = [
    statusListHtml,
    section('Не изучено', unseen, 'Все доступные теории уже изучены.'),
    section('Повторить по теории (где больше ошибок)', repeat, 'Сейчас тем для повторения нет.'),
    section('Изучено и закреплено', done, 'Пока нет закрепленных тем.')
  ].join('');

  grid.querySelectorAll('.theory-details-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.theory-progress-card');
      const panel = card.querySelector('.theory-blocks-panel');
      const arrow = btn.querySelector('.theory-details-arrow');
      const open = panel.style.display !== 'none';
      panel.style.display = open ? 'none' : 'block';
      arrow.style.transform = open ? '' : 'rotate(180deg)';
      btn.querySelector('.theory-details-count').style.display = open ? '' : 'none';
    });
  });
}

function renderSummary(summary) {
  const grid = document.getElementById('summary-grid');
  if (!summary?.length) {
    grid.innerHTML = `<div class="empty-state-goose-card">
      <img src="/images/SVG/гусь грустный.svg" alt="Грустный гусь" class="empty-goose-img">
      <p class="empty-goose-text">Пока заданий для проработки нет — больше практикуйся и изучай теорию!</p>
      <a href="/theory" class="btn btn-primary btn-sm" style="margin-top:12px">Перейти к изучению теории</a>
    </div>`;
    return;
  }
  document.getElementById('summary-hint').style.display = '';

  const sorted = [...summary].sort((a, b) => {
    if (b.weak_count !== a.weak_count) return b.weak_count - a.weak_count;
    return a.accuracy - b.accuracy;
  });

  grid.innerHTML = sorted.map(s => {
    const taskKey = s.word_table.replace('_words', '');
    const taskNum = taskKey.replace('task', '');
    const taskShortName = s.label.replace(/^Задание \d+ — /, '');
    const hasWeak = s.weak_count > 0;
    const urgency = hasWeak ? (s.accuracy < 60 ? 'urgent' : 'needs-work') : 'ok';
    const lastDate = s.last_attempted_at ? formatRelDate(s.last_attempted_at) : null;

    const supportsPractice = ['task9','task10','task11','task12'].includes(taskKey);

    return `
      <div class="task-review-card task-review-${urgency}">
        <div class="task-review-head">
          <span class="task-review-num">№${taskNum}</span>
          <span class="task-review-name">${taskShortName}</span>
        </div>
        <div class="task-review-badge-row">
          ${hasWeak
            ? `<span class="task-review-badge task-review-badge-warn">${s.weak_count} ${pluralWords(s.weak_count)} к повторению</span>`
            : `<span class="task-review-badge task-review-badge-ok">Всё освоено</span>`
          }
          ${lastDate ? `<span class="task-review-date">${lastDate}</span>` : ''}
        </div>
        <div class="task-review-stats">
          <div class="task-review-stat">
            <span class="task-review-stat-val" style="color:${s.accuracy >= 70 ? 'var(--color-success)' : s.accuracy >= 50 ? 'var(--color-warning)' : 'var(--color-error)'}">${s.accuracy}%</span>
            <span class="task-review-stat-lbl">точность</span>
          </div>
          <div class="task-review-stat">
            <span class="task-review-stat-val">${s.mastered_count}</span>
            <span class="task-review-stat-lbl">освоено</span>
          </div>
          <div class="task-review-stat">
            <span class="task-review-stat-val">${s.completed_tasks}</span>
            <span class="task-review-stat-lbl">решённых заданий</span>
          </div>
        </div>
        <div class="accuracy-bar task-review-bar">
          <div class="accuracy-fill" style="width:${s.accuracy}%"></div>
        </div>
        <div class="task-review-actions">
          <button class="btn btn-sm btn-outline" onclick="openWordsModal('${taskKey}', '${s.label.replace(/'/g, "\\'")}')">Подробнее</button>
          ${supportsPractice ? `<a href="/practice?task=${taskKey}" class="btn btn-sm btn-primary">Тренировать →</a>` : ''}
        </div>
      </div>`;
  }).join('');
}

function formatRelDate(dateStr) {
  const d = new Date(dateStr);
  const diff = Math.floor((Date.now() - d) / 86400000);
  if (diff === 0) return 'сегодня';
  if (diff === 1) return 'вчера';
  if (diff < 7) return `${diff} ${pluralDays(diff)} назад`;
  return d.toLocaleDateString('ru-RU');
}

function pluralDays(n) {
  if (n % 10 === 1 && n % 100 !== 11) return 'день';
  if ([2,3,4].includes(n % 10) && ![12,13,14].includes(n % 100)) return 'дня';
  return 'дней';
}

function pluralWords(n) {
  if (n % 10 === 1 && n % 100 !== 11) return 'слово';
  if ([2,3,4].includes(n % 10) && ![12,13,14].includes(n % 100)) return 'слова';
  return 'слов';
}

function renderWeakWordsTabs(weakWords, masteryThreshold, containerId = 'weak-words-container', barId = 'weak-words-tabs-bar') {
  const bar = document.getElementById(barId);
  const container = document.getElementById(containerId);
  const groups = (weakWords || []).filter(g => g.words.length > 0);

  if (!groups.length) {
    if (bar) bar.style.display = 'none';
    container.innerHTML = '<p class="empty-state">Слов для повторения нет — отличная работа!</p>';
    return;
  }

  if (bar) {
    bar.style.display = '';
    bar.innerHTML = groups.map((g, i) => `
      <button class="weak-tab${i === 0 ? ' active' : ''}" data-tab="${g.word_table}">
        ${g.label.replace(/^Задание \d+ — /, '')}
        <span class="weak-tab-count">${g.words.length}</span>
      </button>
    `).join('');
    bar.addEventListener('click', e => {
      const btn = e.target.closest('.weak-tab');
      if (!btn) return;
      bar.querySelectorAll('.weak-tab').forEach(b => b.classList.remove('active'));
      container.querySelectorAll('.weak-tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      container.querySelector(`[data-panel="${btn.dataset.tab}"]`)?.classList.add('active');
    });
  }

  container.innerHTML = groups.map((g, i) => `
    <div class="weak-tab-panel${i === 0 ? ' active' : ''}" data-panel="${g.word_table}">
      <div class="weak-words-list">
        ${g.words.map(w => wordCard(w, masteryThreshold)).join('')}
      </div>
    </div>
  `).join('');
}

function wordCard(w, masteryThreshold) {
  return `
    <div class="weak-word-item">
      <div class="weak-word-top">
        <span class="weak-word-text">${w.word}</span>
        <span class="weak-word-errors">${w.errors} ${pluralErrors(w.errors)}</span>
      </div>
      <div class="weak-word-rule">${w.rule}</div>
      <div class="mastery-bar-wrap">
        <div class="mastery-bar"><div class="mastery-fill" style="width:${w.mastery}%"></div></div>
        <span class="mastery-label">${w.streak}/${masteryThreshold} подряд</span>
      </div>
    </div>`;
}

function pluralErrors(n) {
  if (n % 10 === 1 && n % 100 !== 11) return 'ошибка';
  if ([2,3,4].includes(n % 10) && ![12,13,14].includes(n % 100)) return 'ошибки';
  return 'ошибок';
}

