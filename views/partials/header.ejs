<header class="site-header">
  <button class="theme-toggle" id="theme-toggle" aria-label="Переключить тему">
    <span class="theme-toggle__icon theme-toggle__icon--light">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/>
      </svg>
    </span>
    <span class="theme-toggle__icon theme-toggle__icon--dark">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/>
      </svg>
    </span>
  </button>

  <div class="site-auth" id="auth-section">
    <div id="guest-auth" style="display: none; gap: 16px; align-items: center;">
      <a href="/login" class="header-btn header-btn--outline">Войти</a>
      <a href="/login?tab=register" class="header-btn header-btn--fill">Регистрация</a>
    </div>

    <div id="user-auth" style="display: none;">
      <div class="site-auth__avatar" aria-hidden="true">
        <img id="user-avatar-img" alt="Аватар" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:50%;" />
        <span id="user-avatar">В</span>
      </div>
      <span class="site-auth__chevron" aria-hidden="true">
        <img src="/images/chevron-down.svg" alt="Стрелка вниз"/>
      </span>
      <div class="user-menu" id="user-menu" style="display: none;">
        <div class="user-menu__info">
          <div class="user-menu__name" id="user-name">Пользователь</div>
          <div class="user-menu__email" id="user-contact"></div>
        </div>
        <div class="user-menu__actions">
          <a class="user-menu__action" href="/profile" style="display:block;text-align:left;text-decoration:none;cursor:pointer">Личный кабинет</a>
          <button class="user-menu__action" onclick="logout()">Выйти</button>
        </div>
      </div>
    </div>
  </div>
</header>
