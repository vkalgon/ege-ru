<aside class="sidebar" id="sidebar" aria-label="Навигация">

  <!-- Внутренний контейнер — обрезает текст при сворачивании -->
  <div class="sidebar__inner">

    <div class="sidebar__head">
      <a href="/" class="sidebar__logo" aria-label="Главная">
        <img src="/images/logo.svg" alt="" class="sidebar__logo-img"/>
        <span class="sidebar__logo-name">Буквица ЕГЭ</span>
      </a>
    </div>

    <a href="/profile" class="sidebar__user" id="sidebar-user" style="display:none;" aria-label="Личный кабинет">
      <div class="sidebar__user-avatar">
        <img id="sidebar-avatar-img" alt="Аватар" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:50%;"/>
        <span id="sidebar-avatar-initial">В</span>
      </div>
      <span class="sidebar__user-name" id="sidebar-user-name">Пользователь</span>
    </a>

    <nav class="sidebar__nav" aria-label="Главная навигация">
      <a class="sidebar__link" href="/" data-match="exact" title="Главная">
        <span class="sidebar__icon-wrap">
          <svg class="sidebar__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
          </svg>
        </span>
        <span class="sidebar__label">Главная</span>
      </a>

      <a class="sidebar__link" href="/variant" data-match="prefix" title="Задания">
        <span class="sidebar__icon-wrap">
          <svg class="sidebar__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"/>
          </svg>
        </span>
        <span class="sidebar__label">Задания</span>
      </a>

      <a class="sidebar__link" href="/generate" data-match="exact" title="Генерация">
        <span class="sidebar__icon-wrap">
          <svg class="sidebar__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"/>
          </svg>
        </span>
        <span class="sidebar__label">Генерация</span>
      </a>

      <a class="sidebar__link" href="/theory" data-match="prefix" title="Теория">
        <span class="sidebar__icon-wrap">
          <svg class="sidebar__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
          </svg>
        </span>
        <span class="sidebar__label">Теория</span>
      </a>

      <a class="sidebar__link" href="#" data-match="none" title="Прогресс">
        <span class="sidebar__icon-wrap">
          <svg class="sidebar__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
          </svg>
        </span>
        <span class="sidebar__label">Прогресс</span>
      </a>
    </nav>

  </div><!-- /sidebar__inner -->

  <!-- Кнопка вынесена за inner — не обрезается overflow:hidden -->
  <button class="sidebar__toggle" id="sidebar-toggle" aria-label="Свернуть меню">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/>
    </svg>
  </button>

</aside>

<script>
  (function() {
    var path = window.location.pathname;
    document.querySelectorAll('.sidebar__link[data-match]').forEach(function(link) {
      var match = link.dataset.match;
      var href = link.getAttribute('href');
      if (match === 'exact' && path === href) {
        link.classList.add('is-active');
      } else if (match === 'prefix' && href !== '#' && path.startsWith(href)) {
        link.classList.add('is-active');
      }
    });

    document.getElementById('sidebar-toggle').addEventListener('click', function() {
      document.documentElement.classList.toggle('sidebar-collapsed');
      localStorage.setItem('sidebar-collapsed',
        document.documentElement.classList.contains('sidebar-collapsed'));
    });
  })();
</script>
